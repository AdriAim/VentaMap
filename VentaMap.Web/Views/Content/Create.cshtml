@using System.Globalization
@model CreatePublicationContentViewModel
@{
    ViewData["Title"] = "Crear anuncio";
}

<section class="form-shell create-shell">
    <div class="section-heading">
        <span class="eyebrow">@Model.FormEyebrow</span>
        <h1>@Model.FormTitle</h1>
        <p>@Model.FormDescription</p>
    </div>

    @if (Model.RequiresLogin)
    {
        <section class="empty-state">
            <h2>Solo usuarios registrados</h2>
            <p>Inicia sesion para publicar anuncios con mapa, imagenes y contacto asociado a tu cuenta.</p>
            <a class="primary-pill" href="/Account/Login?returnUrl=/Publications/Create">Iniciar sesion</a>
        </section>
    }
    else if (Model.PublishingBlocked)
    {
        <section class="empty-state">
            <h2>No puedes publicar por el momento</h2>
            <p>@Model.PublishingBlockedMessage</p>
            <p>Si la revisión administrativa determina que no hubo infracción, tu cuenta volverá a quedar habilitada.</p>
            <a class="ghost-pill" href="/MisAnuncios">Ver mis anuncios</a>
        </section>
    }
    else
    {
        <div class="status-banner civic-banner">
            <strong>Publicas como @(Model.CurrentUserName ?? "usuario registrado")</strong>
            <span>Tu cuenta queda asociada a este anuncio.</span>
        </div>

        <div class="status-banner prepublish-guidance">
            <strong>Antes de publicar, revisa las reglas del sitio.</strong>
            <span><a href="/Reglas">Ver reglas de funcionamiento</a> y los precios vigentes <a href="/Precios">Ver precios vigentes</a>.</span>
        </div>

        <div id="create-feedback"></div>

        <div class="create-editor-layout">
        <form id="createPublicationForm"
              class="stack-form create-form"
              autocomplete="off"
              novalidate
              data-skip-system-loading="true"
              data-submit-endpoint="@Model.SubmitEndpoint">
            <input type="hidden" name="title" value="@Model.Input.Title" />
            <input type="hidden" name="latitude" value="@(Model.Input.Latitude.HasValue ? Model.Input.Latitude.Value.ToString(CultureInfo.InvariantCulture) : string.Empty)" />
            <input type="hidden" name="longitude" value="@(Model.Input.Longitude.HasValue ? Model.Input.Longitude.Value.ToString(CultureInfo.InvariantCulture) : string.Empty)" />
            <input type="hidden" name="locality" value="@Model.Input.Locality" />
            <input type="hidden" name="address" value="@Model.Input.Address" />
            <input type="hidden" name="imagesCsv" value="@Model.Input.ImagesCsv" />
            <input type="hidden" name="videoUrl" value="@Model.Input.VideoUrl" />
            <input name="noLocation"
                   type="checkbox"
                   value="true"
                   data-create-no-location
                   hidden
                   @(Model.ShowLocationSection ? null : "checked") />

            <section class="detail-panel create-uploads-panel" data-create-basics-panel>
                <div class="section-heading">
                    <span class="eyebrow create-step-label">Paso 1 - Datos minimos</span>
                    <p>Luego podrás completar opcional ubicación en mapa y ficha técnica para que tu anuncio se posiciones en busquedas de los compradores.</p>
                </div>

                <div class="form-grid">
                    <label data-field-container="group">
                        <span>Tipo</span>
                        <select name="group">
                            @foreach (var group in Model.GroupOptions)
                            {
                                if ((byte)Model.Input.Group == group.Id)
                                {
                                    <option value="@group.Id" selected>@group.Name</option>
                                }
                                else
                                {
                                    <option value="@group.Id">@group.Name</option>
                                }
                            }
                        </select>
                        <span class="field-error" data-field-error="group"></span>
                    </label>

                    <label data-field-container="category">
                        <span>Categoría</span>
                        <select name="category"
                                data-category-select
                                data-category-endpoint="/api/content/categories"
                                data-selected-category-id="@Model.Input.CategoryId">
                            <option value="">Seleccioná una categoría</option>
                            @foreach (var category in Model.Categories)
                            {
                                if (category.Id == Model.Input.CategoryId)
                                {
                                    <option value="@category.Id" selected>@category.Name</option>
                                }
                                else
                                {
                                    <option value="@category.Id">@category.Name</option>
                                }
                            }
                        </select>
                        <span class="field-error" data-field-error="category"></span>
                    </label>

                    <label data-field-container="operation" data-create-operation-field @(Model.OperationOptions.Any() ? null : "hidden")>
                        <span>Tipo de operación</span>
                        <select name="operation"
                                data-create-operation-select
                                data-selected-operation="@(Model.Input.Operation ?? string.Empty)">
                            <option value="">Seleccioná una opción</option>
                            @foreach (var option in Model.OperationOptions)
                            {
                                if (string.Equals(Model.Input.Operation, option, StringComparison.OrdinalIgnoreCase))
                                {
                                    <option value="@option" selected>@option</option>
                                }
                                else
                                {
                                    <option value="@option">@option</option>
                                }
                            }
                        </select>
                        <span class="field-error" data-field-error="operation"></span>
                    </label>

                    <label class="wide" data-field-container="shortDescription">
                        <span>Descripción corta</span>
                        <input name="shortDescription" value="@Model.Input.ShortDescription" maxlength="60" aria-describedby="short-description-hint short-description-count" placeholder="Resumen breve para el listado" />
                        <span class="field-hint" id="short-description-hint">Se muestra debajo de la foto del anuncio, en hasta dos líneas. Máximo 60 caracteres, incluidos los espacios. Si no entra completa, se verá con puntos suspensivos.</span>
                        <span class="field-hint" id="short-description-count" data-short-description-count></span>
                        <span class="field-hint create-description-example" data-description-example="short"></span>
                        <span class="field-error" data-field-error="shortDescription"></span>
                    </label>

                    <label data-field-container="currency">
                        <span>Moneda</span>
                        <select name="currency">
                            @if (Model.Input.Currency == "ARS" || Model.Input.Currency == "AR$")
                            {
                                <option value="AR$" selected>AR$</option>
                            }
                            else
                            {
                                <option value="AR$">AR$</option>
                            }

                            @if (Model.Input.Currency == "USD" || Model.Input.Currency == "U$D")
                            {
                                <option value="U$D" selected>U$D</option>
                            }
                            else
                            {
                                <option value="U$D">U$D</option>
                            }
                        </select>
                        <span class="field-error" data-field-error="currency"></span>
                    </label>

                    <label data-field-container="price">
                        <span class="create-price-head">
                            <span data-create-price-label>Precio</span>
                        </span>
                        <input name="price" type="number" step="0.01" min="0" value="@Model.Input.Price" />
                        <span class="field-hint" data-create-price-period-hint>Para alquileres indicá el valor mensual; para temporarios, el valor diario.</span>
                        <span class="field-error" data-field-error="price"></span>
                    </label>

                    <div class="create-suggestion-field">
                        <span aria-hidden="true">&nbsp;</span>
                        <button type="button"
                                class="ghost-pill compact suggestion-pill suggestion-pill-publish"
                                data-suggestion-open="true"
                                data-suggestion-title="No encuentro la clasificación que necesito"
                                data-suggestion-intro="Describe lo que estas queriendo publicar y que dato te falta para hacerlo con precisión."
                                data-suggestion-label="Cuéntanos qué te falta"
                                data-suggestion-placeholder="Ej. Quiero publicar una camioneta adaptada y no encuentro cómo clasificarla ni qué dato técnico debería completar."
                                data-suggestion-prefix="PUB: ">
                            No encuentro la clasificación que necesito
                        </button>
                    </div>

                    <label class="wide" data-field-container="longDescription">
                        <span>Descripcion completa</span>
                        <textarea name="longDescription" placeholder="Conta lo importante del anuncio">@Model.Input.LongDescription</textarea>
                        <span class="field-hint create-description-example" data-description-example="long"></span>
                        <span class="field-error" data-field-error="longDescription"></span>
                    </label>
                </div>

                <div class="form-grid" data-dynamic-required-fields-container data-category-fields-endpoint-template="/api/categorias/__CATEGORY_ID__/campos">
                    <div class="wide field-hint" data-dynamic-required-fields-empty hidden></div>
                    @foreach (var seed in Model.InitialDynamicFieldValues)
                    {
                        <label data-dynamic-field="true" data-field-container="@seed.InternalName" hidden>
                            <input data-dynamic-input="true" value="@seed.Value" />
                        </label>
                    }
                </div>
            </section>

            <section class="detail-panel create-uploads-panel">
                <div class="section-heading">
                    <span class="eyebrow create-step-label">Paso 2 - Imágenes</span>
                    <h2>Subí hasta 10 fotos</h2>
                    <p>Arrastra y suelta archivos o usa el selector. La primera se toma como principal y podes reorganizarla despues.</p>
                </div>

                <div class="status-banner warning">
                    <strong>Solo se permiten fotos reales del bien/producto ofrecido.</strong>
                    No se permiten imágenes generadas o modificadas con inteligencia artificial (IA), ni imágenes que no correspondan al bien/producto que intentás vender, alquilar u ofrecer. El incumplimiento puede dar lugar al baneo de tu cuenta sin aviso previo.
                    <a href="/Reglas#imagenes">Ver reglas de uso de imágenes</a>.
                </div>

                <div class="upload-dropzone" data-image-dropzone data-field-container="imagesCsv">
                    <input type="file" multiple accept="image/*" data-create-images-input hidden />
                    <div class="upload-photo-tip">
                        <div class="upload-photo-tip-icon" aria-hidden="true">
                            <i class="fa-solid fa-mobile-screen-button"></i>
                            <i class="fa-solid fa-camera-retro upload-photo-tip-camera"></i>
                        </div>
                        <div class="upload-photo-tip-copy">
                            <strong>Optimizada para fotos de celular en vertical</strong>
                            <span>Las imágenes que subas se ven mejor si las sacás con el teléfono en formato vertical.</span>
                        </div>
                    </div>
                    <div class="upload-dropzone-actions">
                        <button type="button" class="primary-pill" data-create-images-pick>Elegir imagenes</button>
                        <button type="button" class="ghost-pill" data-create-images-clear>Limpiar todo</button>
                        <span class="field-hint" data-image-count>0/10 imagenes</span>
                    </div>
                    <div class="upload-previews" data-image-previews></div>
                    <p class="field-hint">El anuncio básico permite hasta 3 fotos; el completo, hasta 10. La primera foto será la principal.</p>
                    <span class="field-error" data-field-error="imagesCsv"></span>
                </div>
            </section>

            <section class="detail-panel create-uploads-panel">
                <div class="section-heading">
                    <span class="eyebrow create-step-label">Paso 3 - Video (opcional)</span>
                    <h2>Subi un video de hasta 1 minuto</h2>
                    <p>Si cargas un video, pasa a ser el contenido principal del anuncio.</p>
                </div>

                <div class="upload-dropzone" data-video-dropzone data-field-container="videoUrl">
                    <input type="file" accept="video/mp4,video/webm,video/quicktime" data-create-video-input hidden />
                    <div class="upload-photo-tip">
                        <div class="upload-photo-tip-icon" aria-hidden="true">
                            <i class="fa-solid fa-mobile-screen-button"></i>
                            <i class="fa-solid fa-video upload-photo-tip-camera"></i>
                        </div>
                        <div class="upload-photo-tip-copy">
                            <strong>Optimizada para videos de celular en vertical</strong>
                            <span>Haz un video mostrando tu producto o animate a venderlo vos en persona, que te conozcan a vos y a tu producto.</span>
                        </div>
                    </div>
                    <div class="upload-dropzone-actions">
                        <button type="button" class="primary-pill" data-create-video-pick>Elegir video</button>
                        <button type="button" class="ghost-pill" data-create-video-clear>Quitar video</button>
                        <span class="field-hint" data-video-status>Sin video</span>
                    </div>
                    <div class="upload-previews" data-video-previews></div>
                    <p class="field-hint">Formatos admitidos: MP4, WEBM o MOV. Duracion maxima: 60 segundos.</p>
                    <span class="field-error" data-field-error="videoUrl"></span>
                </div>
            </section>

            <section class="detail-panel create-map-panel">
                <div class="section-heading" data-section-heading>
                    <span class="eyebrow create-step-label">Ubicación (Opcional)</span>
                    <h2>Marca el punto en el mapa</h2>
                    <p>Busca una direccion o hace clic sobre el mapa para fijar la ubicacion del anuncio.</p>
                    <div class="upload-photo-tip">
                        <div class="upload-photo-tip-icon" aria-hidden="true">
                            <i class="fa-solid fa-map-location-dot"></i>
                            <i class="fa-solid fa-location-dot upload-photo-tip-camera"></i>
                        </div>
                        <div class="upload-photo-tip-copy">
                            <strong>Si no informas la ubicación exacta en el mapa, se publicará para tu localidad de usuario y quedará fuera de las búsquedas en mapa.</strong>
                        </div>
                    </div>
                </div>

                <div class="create-section-toggle">
                    <label class="checkline compact-check">
                        <input name="showLocationSection" type="checkbox" data-section-toggle="location" @(Model.ShowLocationSection ? "checked" : null) />
                        <span>Quiero cargar estos datos para posicionar mejor mi anuncio en busquedas (gratuito).</span>
                    </label>
                </div>

                <div data-section-body="location" hidden>
                    <div class="create-map-toolbar">
                        <label class="wide" data-field-container="locationSearch">
                            <span>Buscar dirección</span>
                            <input name="locationSearch" type="text" value="@Model.SuggestedLocalityLabel" placeholder="Ej.: San Martín 1111, Santa Fe" aria-describedby="location-search-hint" />
                            <span class="field-error" data-field-error="locationSearch"></span>
                        </label>
                        <button type="button" class="primary-pill large" data-create-address-search>Buscar</button>
                    </div>
                    <p class="field-hint" id="location-search-hint">La dirección ingresada se utilizará para ubicar el pin en el mapa y no se publicará. Solo será visible la ubicación marcada en el mapa. Ejemplo de búsqueda: San Martín 1111, Santa Fe.</p>

                    <div class="create-map-canvas"
                         data-create-map
                         data-map-style-url="@Model.MapStyleUrl"
                         data-map-tiles-url="@Model.MapTilesUrlTemplate"
                         data-map-attribution="@Model.MapAttributionHtml"
                         data-map-initial-lat="@(Model.SuggestedMapLatitude.HasValue ? Model.SuggestedMapLatitude.Value.ToString(CultureInfo.InvariantCulture) : string.Empty)"
                         data-map-initial-lng="@(Model.SuggestedMapLongitude.HasValue ? Model.SuggestedMapLongitude.Value.ToString(CultureInfo.InvariantCulture) : string.Empty)"
                         data-map-geocoding-search-url="@Model.MapGeocodingSearchUrlTemplate"
                         data-map-reverse-geocoding-url="@Model.MapReverseGeocodingUrlTemplate"></div>
                    <p class="create-map-summary" data-create-location-summary>
                        @(string.IsNullOrWhiteSpace(Model.SuggestedLocalityLabel)
                            ? "Elegi una ubicacion en el mapa o buscala por direccion."
                            : $"Ubicacion sugerida segun tu cuenta: {Model.SuggestedLocalityLabel}.")
                    </p>
                    @if (!string.IsNullOrWhiteSpace(Model.SuggestedLocalityLabel))
                    {
                        <p class="field-hint">Si no marcas un punto, el anuncio se publicará para tu localidad de usuario: <strong>@Model.SuggestedLocalityLabel</strong>, y no aparecerá en búsquedas de mapa.</p>
                    }
                </div>
            </section>

            <section class="detail-panel create-technical-panel" data-technical-panel hidden>
                <div class="section-heading" data-section-heading>
                    <span class="eyebrow create-step-label">Ficha tecnica (Opcional)</span>
                    <h2>Completa detalles opcionales</h2>
                    <p>Posicionarán mucho mejor tu anuncio en las busquedas y brindarán información mas precisa a los compradores.</p>
                    <div class="upload-photo-tip">
                        <div class="upload-photo-tip-icon" aria-hidden="true">
                            <i class="fa-solid fa-list-check"></i>
                            <i class="fa-solid fa-magnifying-glass upload-photo-tip-camera"></i>
                        </div>
                        <div class="upload-photo-tip-copy">
                            <strong>Si cargas la ficha además de mostrar la información tus anuncios participarán de busquedas avanzadas para el comprador.</strong>
                        </div>
                    </div>
          
                </div>

                <div class="create-section-toggle">
                    <label class="checkline compact-check">
                        <input name="showTechnicalSection" type="checkbox" data-section-toggle="technical" @(Model.ShowTechnicalSection ? "checked" : null) />
                        <span>Quiero cargar estos datos para posicionar mejor mi anuncio en busquedas (gratuito).</span>
                    </label>
                </div>

                <div data-section-body="technical" hidden>
                    <div class="form-grid" data-dynamic-optional-fields-container data-category-fields-endpoint-template="/api/categorias/__CATEGORY_ID__/campos">
                        <div class="wide field-hint" data-dynamic-optional-fields-empty hidden>Seleccioná una categoría para cargar la ficha técnica opcional.</div>
                    </div>
                </div>
            </section>

            @if (Model.IsPaidSiteEnabled && Model.ShowPublicationChargeEstimator && !Model.IsCompanyAccount)
            {
                <section class="status-banner civic-banner create-pricing-estimator create-pricing-estimator-mobile" data-publication-charge-estimator
                         data-company="@Model.IsCompanyAccount.ToString().ToLowerInvariant()"
                         data-exempt="@Model.IsBillingExempt.ToString().ToLowerInvariant()"
                         data-active-count="@Model.ActivePublicationCount">
                    <strong data-charge-estimator-title>Calculando costo…</strong>
                    <span data-charge-estimator-detail></span>
                </section>
            }

            <div class="hero-actions">
                <button type="submit" class="primary-pill">@Model.SubmitButtonText</button>
                <a class="ghost-pill" href="@Model.CancelUrl">Cancelar</a>
            </div>
        </form>
        <aside class="create-live-preview" aria-label="Vista previa del anuncio">
            <h2>Así se verá tu anuncio</h2>
            <p class="field-hint">La vista previa cambia a medida que completás los datos.</p>
            <article class="listing-card listing-card-compact">
                <div class="card-image-wrap gallery-card-with-caption">
                    <div class="create-preview-media" data-create-preview-media></div>
                    <span class="gallery-price-cluster">
                        <span class="gallery-badge gallery-tooltip-trigger gallery-tooltip-bottom" data-create-preview-price></span>
                    </span>
                    <span class="gallery-card-caption gallery-description-tooltip gallery-tooltip-trigger" data-create-preview-description tabindex="0"><span></span></span>
                </div>
            </article>
            @if (Model.IsPaidSiteEnabled && Model.ShowPublicationChargeEstimator && !Model.IsCompanyAccount)
            {
                <section class="status-banner civic-banner create-pricing-estimator create-pricing-estimator-desktop" data-publication-charge-estimator
                         data-company="@Model.IsCompanyAccount.ToString().ToLowerInvariant()"
                         data-exempt="@Model.IsBillingExempt.ToString().ToLowerInvariant()"
                         data-active-count="@Model.ActivePublicationCount">
                    <strong data-charge-estimator-title>Calculando costo…</strong>
                    <span data-charge-estimator-detail></span>
                </section>
            }
        </aside>
        </div>
    }
</section>
