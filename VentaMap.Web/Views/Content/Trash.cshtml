@model TrashContentViewModel

<section class="form-shell">
    <div class="section-heading">
        <span class="eyebrow">Papelera</span>
        <h1>Anuncios enviados por la comunidad</h1>
        <p>AcÃ¡ aparecen los anuncios denunciados. Si un aviso fue marcado por no corresponder, fraude o falta de precio, se ve acÃ¡ con su historial bÃ¡sico.</p>
    </div>

    @if (!Model.Publications.Any())
    {
        <section class="empty-state">
            <h2>La papelera estÃ¡ vacÃ­a.</h2>
            <p>TodavÃ­a no hay anuncios denunciados por la comunidad.</p>
        </section>
    }
    else
    {
        <section class="classified-list">
            @foreach (var item in Model.Publications)
            {
                var publication = item.Publication;
                <article class="classified-row">
                    <div>
                        <span class="card-meta">@publication.Group Â· @(publication.Category?.Name ?? "Sin categoria") Â· @publication.Locality</span>
                        <h3><a href="/Publications/Details/@publication.Id">@(string.IsNullOrWhiteSpace(publication.ShortDescription) ? publication.Title : publication.ShortDescription)</a></h3>
                        <div class="trash-tags">
                            @foreach (var reason in publication.Reports.OrderByDescending(r => r.CreatedAtUtc).Take(3).Select(r => r.Reason?.Name ?? $"RazÃ³n #{r.ReasonId}"))
                            {
                                <span class="trash-tag">@reason</span>
                            }
                        </div>
                        @{
                            var reportComment = publication.Reports
                                .OrderByDescending(r => r.CreatedAtUtc)
                                .FirstOrDefault(r => !string.IsNullOrWhiteSpace(r.Comment))?.Comment;
                        }
                        @if (!string.IsNullOrWhiteSpace(reportComment))
                        {
                            <p class="trash-comment">@reportComment</p>
                        }
                    </div>
                    <div class="classified-side">
                        <strong>@item.PendingReportsCount denuncia(s)</strong>
                        <span>@publication.Currency @publication.Price.ToString("0")</span>
                    </div>
                </article>
            }
        </section>
    }
</section>

