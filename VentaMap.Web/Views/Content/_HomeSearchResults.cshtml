@model HomeContentViewModel
@{
    var currentMode = string.IsNullOrWhiteSpace(Model.Mode) ? "Galeria" : Model.Mode;
    var currentGroup = string.IsNullOrWhiteSpace(Model.Group) ? "Inmuebles" : Model.Group;
    var previousPage = Math.Max(1, Model.Page - 1);
    var nextPage = Math.Min(Math.Max(1, Model.TotalPages), Model.Page + 1);
    var selectedFilters = Model.SelectedFieldFilters ?? [];
    var operationField = (Model.RequiredFilterFields ?? [])
        .FirstOrDefault(x => string.Equals(x.InternalName, "operacion", StringComparison.OrdinalIgnoreCase));
    string[] SplitOptions(string? optionsCsv) => string.IsNullOrWhiteSpace(optionsCsv)
        ? []
        : optionsCsv.Split([';', ','], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
    var operationOptions = SplitOptions(operationField?.OptionsCsv);
    var debugEnabled = string.Equals(Context?.Request.Query["debug"], "1", StringComparison.Ordinal);
    var debugSuffix = debugEnabled ? "?debug=1" : string.Empty;
    var baseQueryParts = new List<string>
    {
        $"group={Uri.EscapeDataString(currentGroup)}",
        $"mode={Uri.EscapeDataString(currentMode)}",
        $"query={Uri.EscapeDataString(Model.Query ?? string.Empty)}"
    };

    if (Model.SelectedCategoryId.HasValue)
    {
        baseQueryParts.Add($"categoryId={Model.SelectedCategoryId.Value}");
    }

    if (Model.PriceFrom.HasValue)
    {
        baseQueryParts.Add($"priceFrom={Uri.EscapeDataString(Model.PriceFrom.Value.ToString(System.Globalization.CultureInfo.InvariantCulture))}");
    }

    if (Model.PriceTo.HasValue)
    {
        baseQueryParts.Add($"priceTo={Uri.EscapeDataString(Model.PriceTo.Value.ToString(System.Globalization.CultureInfo.InvariantCulture))}");
    }

    if (Model.RadiusKm.HasValue)
    {
        baseQueryParts.Add($"radioKm={Model.RadiusKm.Value}");
    }

    if (!string.IsNullOrWhiteSpace(Model.Operation))
    {
        baseQueryParts.Add($"operation={Uri.EscapeDataString(Model.Operation)}");
    }

    foreach (var filter in selectedFilters.Where(x => x.FieldId > 0 && !string.IsNullOrWhiteSpace(x.Value)))
    {
        baseQueryParts.Add($"filterFieldId={filter.FieldId}");
        baseQueryParts.Add($"filterValue={Uri.EscapeDataString(filter.Value ?? string.Empty)}");
    }

    if (debugEnabled)
    {
        baseQueryParts.Add("debug=1");
    }

    string BuildSearchUrl(int page, int pageSize, string? mode = null)
    {
        var parts = baseQueryParts
            .Where(x => !x.StartsWith("mode=", StringComparison.OrdinalIgnoreCase))
            .ToList();
        parts.Insert(1, $"mode={Uri.EscapeDataString(mode ?? currentMode)}");
        parts.Add($"page={page}");
        parts.Add($"pageSize={pageSize}");
        return $"/?{string.Join("&", parts)}";
    }

    string GetQueryPlaceholder(string group) => group switch
    {
        "Inmuebles" => "Ej. departamento, casa con patio, lote",
        "Rodados" => "Ej. Ford Fiesta, moto, camioneta",
        "Embarcaciones" => "Ej. lancha, velero, semirrigido",
        "Agro" => "Ej. tractor, sembradora, generador",
        "Electronica" => "Ej. celular, notebook, playstation",
        "Generales" => "Ej. muebles, bicicleta, herramientas",
        "Moda" => "Ej. zapatillas, campera, cartera",
        "Todos" => "Ej. departamento, Ford Fiesta, iPhone",
        _ => "Ej. departamento, Ford Fiesta, iPhone"
    };

    var resultsLayoutModel = new ResultsLayoutViewModel
    {
        Results = Model,
        CurrentMode = currentMode,
        CurrentGroup = currentGroup,
        ViewLabel = currentMode == "Mapa"
            ? "Vista mapa"
            : currentMode == "Texto"
                ? "Vista lista"
                : "Vista galeria",
        DebugSuffix = debugSuffix,
        TextViewUrl = $"{BuildSearchUrl(1, Model.PageSize, "Texto")}#browse-results",
        GalleryViewUrl = $"{BuildSearchUrl(1, Model.PageSize, "Galeria")}#search-panel",
        MapViewUrl = $"{BuildSearchUrl(1, Model.PageSize, "Mapa")}#browse-results",
        PageSize50Url = BuildSearchUrl(1, 50, "Texto"),
        PageSize100Url = BuildSearchUrl(1, 100, "Texto"),
        PageSize200Url = BuildSearchUrl(1, 200, "Texto"),
        PreviousPageUrl = BuildSearchUrl(previousPage, Model.PageSize, "Texto"),
        NextPageUrl = BuildSearchUrl(nextPage, Model.PageSize, "Texto"),
        CanGoPreviousPage = Model.Page > 1,
        CanGoNextPage = Model.Page < Model.TotalPages,
        ShowMapSelectionDescription = true,
        MapSelectionDescription = "Al tocar un pin, aca se muestra la misma tarjeta visual de la galeria."
    };
}

<section class="search-panel" id="search-panel">
    <form method="get" action="/" class="search-grid search-grid-minimal" data-group-aware-search-form="true" data-required-filter-fields-endpoint="/api/content/required-filter-fields">
        <label class="search-control search-query-control">
            <span class="search-control-label">Que buscas</span>
            <input name="query" value="@Model.Query" placeholder="@GetQueryPlaceholder(currentGroup)" data-group-aware-query-input="true" />
        </label>
        <label class="search-control">
            <span class="search-control-label">Grupo</span>
            <select name="group"
                    data-placeholder-inmuebles="Ej. departamento, casa con patio, lote"
                    data-placeholder-rodados="Ej. Ford Fiesta, moto, camioneta"
                    data-placeholder-embarcaciones="Ej. lancha, velero, semirrigido"
                    data-placeholder-agro="Ej. tractor, sembradora, generador"
                    data-placeholder-electronica="Ej. celular, notebook, playstation"
                    data-placeholder-generales="Ej. muebles, bicicleta, herramientas"
                    data-placeholder-moda="Ej. zapatillas, campera, cartera"
                    data-placeholder-todos="Ej. departamento, Ford Fiesta, iPhone">
                @foreach (var group in Model.GroupOptions)
                {
                    if (currentGroup == group.Name)
                    {
                        <option selected>@group.Name</option>
                    }
                    else
                    {
                        <option>@group.Name</option>
                    }
                }
            </select>
        </label>
        <label class="search-control" data-group-category-wrapper>
            <span class="search-control-label">Categoria</span>
            <select name="categoryId"
                    data-group-category-select="true"
                    data-selected-category-id="@(Model.SelectedCategoryId?.ToString() ?? string.Empty)"
                    data-categories-endpoint="/api/content/categories">
                <option value="">Todas</option>
                @foreach (var category in Model.CategoryOptions)
                {
                    if (Model.SelectedCategoryId == category.Id)
                    {
                        <option value="@category.Id" selected>@category.Name</option>
                    }
                    else
                    {
                        <option value="@category.Id">@category.Name</option>
                    }
                }
            </select>
        </label>
        <label class="search-control">
            <span class="search-control-label">Tipo de operación</span>
            <select name="operation" required data-group-operation-select="true" data-selected-operation="@(Model.Operation ?? string.Empty)">
                <option value="">Tipo de operación</option>
                @foreach (var option in operationOptions)
                {
                    <option value="@option" selected="@(string.Equals(Model.Operation, option, StringComparison.OrdinalIgnoreCase))">@option</option>
                }
            </select>
        </label>
        <input type="hidden" name="mode" value="@currentMode" />
        <input type="hidden" name="pageSize" value="50" />
        <input type="hidden" name="page" value="1" />
        @if (debugEnabled)
        {
            <input type="hidden" name="debug" value="1" />
        }
        <button type="submit" class="primary-pill large search-submit-control">Buscar</button>
    </form>
</section>
<hr class="search-panel-divider" />

@if (!string.IsNullOrWhiteSpace(Model.FlashMessage))
{
    <div class="status-banner">@Model.FlashMessage</div>
}

@if (Model.RequireLocalitySelection)
{
    <div data-browse-locality-required="true" hidden></div>
    <section class="empty-state" data-browse-scroll-target>
        <h2>Elegi tu localidad para ver anuncios</h2>
        <p>Necesitamos una localidad seleccionada para mostrar resultados cercanos y ordenar la busqueda.</p>
    </section>
}
else if (false && Model.CanManageFavorites)
{
    <section class="favorites-strip" data-favorites-summary>
        <div class="favorites-strip-copy">
            <span class="eyebrow">Mis listas</span>
            <h2>Favoritos guardados</h2>
        </div>
        <div class="favorites-strip-actions" data-favorites-summary-actions>
            @if (Model.FavoriteLists.Any())
            {
                @foreach (var list in Model.FavoriteLists)
                {
                    <button type="button" class="view-pill" data-favorite-list-open="true" data-list-id="@list.Id" data-list-name="@list.Name">
                        @list.Name (@list.ItemCount)
                    </button>
                }
            }
            else
            {
                <span class="field-hint">Todavia no guardaste anuncios en tus listas.</span>
            }
        </div>
    </section>
}

else if (currentMode == "Mapa")
{
    <partial name="~/Views/Content/Results/_ResultsMapLayout.cshtml" model="resultsLayoutModel" />
}
else if (currentMode == "Texto")
{
    <partial name="~/Views/Content/Results/_ResultsListLayout.cshtml" model="resultsLayoutModel" />
}
else
{
    <partial name="~/Views/Content/Results/_ResultsGalleryLayout.cshtml" model="resultsLayoutModel" />
}
