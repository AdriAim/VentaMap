@page
@model IndexModel
@{
    ViewData["Title"] = "Buscar inmuebles en mapa | Venta de inmuebles";
    ViewData["MetaDescription"] = "Busca inmuebles en mapa y encuentra casas, departamentos, terrenos y propiedades en venta en Argentina. VentaMap reúne avisos con ubicación, fotos y precios.";
    var endpoint = $"/api/content/home?group={Uri.EscapeDataString(Model.Group)}&mode={Uri.EscapeDataString(Model.Mode)}&query={Uri.EscapeDataString(Model.Query ?? string.Empty)}";
    if (!string.IsNullOrWhiteSpace(Model.Operation))
    {
        endpoint += $"&operation={Uri.EscapeDataString(Model.Operation)}";
    }
    if (string.Equals(Request.Query["debug"], "1", StringComparison.Ordinal))
    {
        endpoint += "&debug=1";
    }
    if (Model.CategoryId.HasValue)
    {
        endpoint += $"&categoryId={Model.CategoryId.Value}";
    }
}

@if (TempData["AccountCreatedMessage"] is string accountCreatedMessage)
{
    <div class="status-banner success-banner account-created-banner" role="status">@accountCreatedMessage</div>
}

<div id="api-page"
     data-page-kind="home"
     data-api-endpoint="@endpoint">
</div>

<partial name="_GlobalModals" model="Model" />
