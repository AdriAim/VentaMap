@page
@model VentaMap.Pages.TrashModel
@{
    ViewData["Title"] = "Bandeja de revisión";
}

<section class="form-shell">
    <div class="section-heading">
        <span class="eyebrow">Moderación</span>
        <h1>Bandeja de revisión de denuncias</h1>
        <p>Aquí aparecen los anuncios que llegaron a papelera luego de acumular 10 denuncias de 10 usuarios diferentes.</p>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
    {
        <div class="status-banner success-banner">@Model.SuccessMessage</div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="status-banner danger-banner">@Model.ErrorMessage</div>
    }

    @if (!Model.Publications.Any())
    {
        <section class="empty-state">
            <h2>No hay anuncios pendientes de revisión.</h2>
            <p>Cuando un anuncio llegue al umbral automático aparecerá aquí.</p>
        </section>
    }
    else
    {
        <section class="classified-list">
            @foreach (var item in Model.Publications)
            {
                var publication = item.Publication;
                var ownerName = publication.User?.Name ?? publication.ContactName;
                var ownerEmail = publication.User?.Email ?? publication.ContactEmail ?? "Sin email";
                var latestComment = publication.Reports
                    .Where(r => r.ReviewStatus == "Pending" && !string.IsNullOrWhiteSpace(r.Comment))
                    .OrderByDescending(r => r.CreatedAtUtc)
                    .Select(r => r.Comment)
                    .FirstOrDefault();

                <article class="classified-row">
                    <div>
                        <span class="card-meta">@publication.Group · @(publication.Category?.Name ?? "Sin categoría") · @publication.Locality</span>
                        <h3><a href="/Publications/Details/@publication.Id">@(string.IsNullOrWhiteSpace(publication.ShortDescription) ? publication.Title : publication.ShortDescription)</a></h3>
                        <p><strong>Publicante:</strong> @ownerName · @ownerEmail</p>
                        <div class="trash-tags">
                            @foreach (var reason in publication.Reports
                                .Where(r => r.ReviewStatus == "Pending")
                                .OrderByDescending(r => r.CreatedAtUtc)
                                .Select(r => r.Reason?.Name ?? $"Razón #{r.ReasonId}")
                                .Distinct()
                                .Take(4))
                            {
                                <span class="trash-tag">@reason</span>
                            }
                        </div>
                        @if (!string.IsNullOrWhiteSpace(latestComment))
                        {
                            <p class="trash-comment">@latestComment</p>
                        }
                        <p>
                            <strong>@item.PendingReportsCount denuncia(s) pendientes</strong>
                            · @item.DistinctReportersCount usuario(s) distintos
                            · Estado: @publication.ModerationStatus
                        </p>
                    </div>
                    <div class="classified-side">
                        <strong>@publication.Currency @publication.Price.ToString("0")</strong>
                        <span>@(publication.TrashedAtUtc?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "-")</span>
                        <form method="post" asp-page-handler="Restore" asp-route-id="@publication.Id">
                            <button type="submit" class="ghost-pill">Restaurar y habilitar</button>
                        </form>
                        <form method="post" asp-page-handler="Confirm" asp-route-id="@publication.Id">
                            <button type="submit" class="danger-pill">Confirmar papelera</button>
                        </form>
                    </div>
                </article>
            }
        </section>
    }
</section>

<section class="form-shell">
    <div class="section-heading">
        <span class="eyebrow">Bajas voluntarias</span>
        <h1>Comentarios de usuarios al dar de baja</h1>
        <p>Aquí aparecen los anuncios que el usuario dio de baja manualmente, con el motivo elegido y el comentario opcional para responder.</p>
    </div>

    @if (!Model.VoluntaryDeactivations.Any())
    {
        <section class="empty-state">
            <h2>No hay bajas voluntarias con comentarios para revisar.</h2>
            <p>Cuando un usuario dé de baja un anuncio y deje motivo o comentario, aparecerá aquí.</p>
        </section>
    }
    else
    {
        <section class="classified-list">
            @foreach (var item in Model.VoluntaryDeactivations)
            {
                var publication = item.Publication;

                <article class="classified-row">
                    <div>
                        <span class="card-meta">@publication.Group · @(publication.Category?.Name ?? "Sin categoría") · @publication.Locality</span>
                        <h3><a href="/Publications/Details/@publication.Id">@(string.IsNullOrWhiteSpace(publication.ShortDescription) ? publication.Title : publication.ShortDescription)</a></h3>
                        <p><strong>Usuario:</strong> @item.OwnerName</p>
                        <p><strong>Mail para responder:</strong> <a href="mailto:@item.OwnerEmail">@item.OwnerEmail</a></p>
                        <p><strong>Motivo de baja:</strong> @publication.DeactivationReason</p>
                        @if (!string.IsNullOrWhiteSpace(publication.DeactivationComment))
                        {
                            <p class="trash-comment">@publication.DeactivationComment</p>
                        }
                    </div>
                    <div class="classified-side">
                        <strong>@publication.Currency @publication.Price.ToString("0")</strong>
                        <span>@(publication.DeactivatedAtUtc?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "-")</span>
                    </div>
                </article>
            }
        </section>
    }
</section>

<section class="form-shell">
    <div class="section-heading">
        <span class="eyebrow">Sugerencias</span>
        <h1>Mensajes enviados al sitio</h1>
        <p>Aquí aparecen las sugerencias enviadas desde el botón de la portada y la navegación principal.</p>
    </div>

    @if (!Model.Suggestions.Any())
    {
        <section class="empty-state">
            <h2>No hay sugerencias enviadas.</h2>
            <p>Cuando un usuario mande una sugerencia desde el popup, aparecerá aquí.</p>
        </section>
    }
    else
    {
        <section class="classified-list">
            @foreach (var item in Model.Suggestions)
            {
                var senderName = item.User?.Name ?? item.SenderName ?? "Anónimo";
                var senderEmail = item.User?.Email ?? item.SenderEmail;

                <article class="classified-row">
                    <div>
                        <span class="card-meta">Sugerencia · @(item.CreatedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm"))</span>
                        <h3>@senderName</h3>
                        <p class="trash-comment">@item.Message</p>
                        <p>
                            <strong>Mail para responder:</strong>
                            @if (string.IsNullOrWhiteSpace(senderEmail))
                            {
                                <span>Sin mail asociado</span>
                            }
                            else
                            {
                                <a href="mailto:@senderEmail">@senderEmail</a>
                            }
                        </p>
                    </div>
                </article>
            }
        </section>
    }
</section>
