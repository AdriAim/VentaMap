@page "/Mensajes/{id:int?}"
@model VentaMap.Pages.Messages.IndexModel
@{
    ViewData["Title"] = "Mensajes";
}

<section class="chat-shell"
         data-chat-page
         data-chat-base-url="@Model.ChatBaseUrl"
         data-chat-api-base-url="@Model.ChatApiBaseUrl"
         data-chat-hub-url="@Model.ChatHubUrl"
         data-initial-conversation-id="@(Model.Id?.ToString() ?? string.Empty)">
    <aside class="chat-sidebar">
        <div class="chat-sidebar-header">
            <div>
                <span class="eyebrow">Mensajes</span>
                <h1>Conversaciones</h1>
            </div>
            <span class="chat-sidebar-count">...</span>
        </div>
        <div class="empty-state compact-empty">
            <h3>Cargando conversaciones...</h3>
            <p>Estamos consultando el servicio de chat.</p>
        </div>
    </aside>

    <section class="chat-thread">
        <div class="empty-state chat-empty-thread">
            <div>
                <h2>Cargando conversacion</h2>
                <p>Espera un momento mientras preparamos la bandeja.</p>
            </div>
        </div>
    </section>
</section>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
    <script src="~/js/chat-page.js" asp-append-version="true"></script>
}
