@page
@model VentaMap.Pages.Publications.CreateModel
@{
    ViewData["Title"] = "Crear anuncio";
    var endpoint = "/api/content/create";
    if (string.Equals(Request.Query["debug"], "1", StringComparison.Ordinal))
    {
        endpoint += "?debug=1";
    }
}

<div id="api-page" data-page-kind="create" data-api-endpoint="@endpoint"></div>
