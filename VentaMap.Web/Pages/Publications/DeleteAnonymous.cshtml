@page
@model VentaMap.Pages.Publications.DeleteAnonymousModel
@{
    ViewData["Title"] = "Eliminar anuncio";
}

<section class="form-shell narrow">
    <div class="section-heading">
        <span class="eyebrow">Anuncio anonimo</span>
        <h1>Eliminar definitivamente un anuncio</h1>
        <p>Ingresa el ID y la contrasena que se genero al crear el aviso. Esta accion borra tambien sus imagenes y video.</p>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
    {
        <div class="status-banner">@Model.StatusMessage</div>
    }

    <form method="post" class="stack-form">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="form-grid">
            <label><span>ID anuncio</span><input asp-for="Input.PublicationId" type="number" /></label>
            <label><span>Contrasena</span><input asp-for="Input.Password" /></label>
        </div>
        <div class="hero-actions">
            <button type="submit" class="danger-pill">Eliminar definitivamente</button>
            <a class="ghost-pill" asp-page="/Index">Volver</a>
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
