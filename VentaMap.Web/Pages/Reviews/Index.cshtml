@page
@model VentaMap.Pages.Reviews.IndexModel
@using VentaMap.Models
@{
    ViewData["Title"] = "Mis operaciones y reseñas";
}

<section class="favorites-strip favorites-page-strip rating-page-header">
    <div class="favorites-strip-copy">
        <span class="eyebrow">Reputacion</span>
        <h1>Mis operaciones y reseñas</h1>
        <p>Confirma operaciones reales y deja reseñas honestas. Las respuestas permanecen ocultas para evitar represalias.</p>
    </div>
</section>

@if (!Model.ReviewsEnabled)
{
    <div class="status-banner">El sistema de reseñas esta temporalmente desactivado.</div>
}
@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <div class="status-banner success-banner">@Model.StatusMessage</div>
}
@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="status-banner danger-banner">@Model.ErrorMessage</div>
}

<div class="status-banner civic-banner rating-history-warning">
    <strong>Tu historial importa.</strong>
    <span>Las operaciones confirmadas construyen confianza y ayudan a otros usuarios a decidir con mayor seguridad. Confirmar una operacion no significa que haya salido bien.</span>
</div>

@if (Model.Operations.Count == 0)
{
    <section class="empty-state">
        <h2>Todavia no tienes operaciones registradas.</h2>
        <p>Cuando una venta se cierre usando tu email aparecera en esta pantalla.</p>
    </section>
}
else
{
    <section class="rating-transaction-list">
        @foreach (var item in Model.Operations)
        {
            var operation = item.Operation;
            var roleLabel = item.CurrentUserIsAdvertiser ? "Publicaste este anuncio" : "Respondiste a este anuncio";
            var operationTypeLabel = operation.OperationType?.ToDisplayName() ?? "Operacion";
            <article class="rating-transaction-card">
                <header>
                    <div>
                        <span class="gallery-kicker">@roleLabel · @operationTypeLabel</span>
                        <h2>@operation.Publication?.Title</h2>
                    </div>
                    <span class="publication-admin-status @(operation.Status == VerifiedOperationStatuses.Confirmed ? "is-active" : "is-inactive")">
                        @(operation.Status == VerifiedOperationStatuses.Confirmed ? "Operacion confirmada" : operation.Status == VerifiedOperationStatuses.Rejected ? "Operacion no reconocida" : "Esperando confirmacion")
                    </span>
                </header>
                <p>
                    Otra persona:
                    <strong>@(item.OtherUser?.Name ?? operation.CounterpartyEmail)</strong>
                </p>
                @if (operation.CounterpartyReportedProblem)
                {
                    <div class="status-banner danger-banner">La otra persona confirmo la operacion e informo que tuvo un problema.</div>
                }

                @if (item.OwnReview is not null)
                {
                    <div class="rating-submitted-state">
                        @if (item.OwnReview.DeclinedToRate)
                        {
                            <strong>Elegiste no dejar una reseña.</strong>
                        }
                        else
                        {
                            <strong aria-label="@item.OwnReview.Stars estrellas">@(new string('★', item.OwnReview.Stars ?? 0))</strong>
                            <p>@item.OwnReview.Comment</p>
                        }
                        <span>Tu respuesta esta guardada. Se publicara cuando se cumpla el periodo de espera.</span>
                    </div>
                }
                else if (item.CanReview && Model.ReviewsEnabled)
                {
                    <form method="post" asp-page-handler="Review" class="stack-form rating-review-form">
                        <input type="hidden" name="operationId" value="@operation.Id" />
                        <label>
                            <span>Estrellas</span>
                            <select name="stars" required>
                                <option value="">Selecciona</option>
                                <option value="5">★★★★★ - Excelente</option>
                                <option value="4">★★★★ - Muy buena</option>
                                <option value="3">★★★ - Regular</option>
                                <option value="2">★★ - Mala</option>
                                <option value="1">★ - Muy mala</option>
                            </select>
                        </label>
                        <label>
                            <span>Tu reseña</span>
                            <textarea name="comment" rows="4" maxlength="1000" required placeholder="Cuenta como fue la experiencia."></textarea>
                        </label>
                        <div class="hero-actions">
                            <button type="submit" class="primary-pill">Guardar reseña</button>
                            <button type="submit" name="declinedToReview" value="true" formnovalidate class="ghost-pill">No deseo dejar una reseña</button>
                        </div>
                    </form>
                }
                else if (operation.Status == VerifiedOperationStatuses.PendingCounterpartyConfirmation)
                {
                    <p class="field-hint">La otra persona debe responder el enlace enviado por email.</p>
                }
                else if (operation.Status == VerifiedOperationStatuses.Confirmed && item.OtherUser is null)
                {
                    <p class="field-hint">La otra persona debe registrarse con el email de la operacion para habilitar las reseñas.</p>
                }
            </article>
        }
    </section>
}
