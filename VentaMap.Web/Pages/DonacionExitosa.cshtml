@page
@{
    ViewData["Title"] = "Gracias por tu aporte";
    ViewData["MetaDescription"] = "Gracias por apoyar a VentaMap.";
}

<section class="form-shell narrow donation-shell donation-success-shell">
    <div class="section-heading">
        <span class="eyebrow">Aporte confirmado</span>
        <h1>¡Gracias Totales!</h1>
        <p class="donation-success-message">Seguimos trabajando para vos.</p>
    </div>

    <div class="donation-card donation-success-card">
        <i class="fa-solid fa-circle-check donation-success-icon" aria-hidden="true"></i>
        <p>Tu aporte ayuda a que VentaMap y su comunidad sigan creciendo.</p>
        <p class="donation-reminder">Recordá: el día más feliz de la vida es hoy <i class="fa-solid fa-heart" aria-hidden="true"></i></p>
        <a class="primary-pill donation-link" href="/">Volver a la portada</a>
    </div>
</section>
