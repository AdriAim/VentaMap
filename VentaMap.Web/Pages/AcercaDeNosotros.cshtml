@page
@{
    ViewData["Title"] = "Acerca de nosotros";
    ViewData["MetaDescription"] = "VentaMap: una comunidad local hecha en Santa Fe, Argentina.";
}

<section class="form-shell narrow donation-shell">
    <div class="section-heading">
        <span class="eyebrow">Acerca de nosotros</span>
        <h1>Apostá por lo local</h1>
        <p><span class="donation-brand">VentaMap</span> <span class="donation-message">está hecho en <span class="donation-location">Santa Fe, Argentina</span>, con pasión, dedicación y mucho corazón.</span></p>
    </div>

    <div class="donation-card">
        <p>Tu aporte ayuda a que esta comunidad y sus anuncios sigan creciendo.</p>
        <a class="primary-pill donation-link" asp-page="/Donar"><i class="fa-solid fa-heart" aria-hidden="true"></i>Donar</a>
    </div>
</section>
