@page
@model VentaMap.Pages.Account.ResetPasswordModel
@{
    ViewData["Title"] = "Blanquear contraseña";
}

<section class="form-shell narrow">
    <div class="section-heading">
        <span class="eyebrow">Acceso</span>
        <h1>Blanquear contraseña</h1>
        <p>Elegí una nueva contraseña para tu cuenta.</p>
    </div>

    <form method="post" class="stack-form">
        <input type="hidden" asp-for="Input.Email" />
        <input type="hidden" asp-for="Input.Token" />
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
        {
            <div class="status-banner warning">@Model.StatusMessage</div>
        }
        <div class="register-row">
            <label>
                <span>Nueva contraseña</span>
                <input asp-for="Input.Password" type="password" autocomplete="new-password" />
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </label>
        </div>
        <div class="register-row">
            <label>
                <span>Repetir contraseña</span>
                <input asp-for="Input.ConfirmPassword" type="password" autocomplete="new-password" />
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
            </label>
        </div>
        <div class="hero-actions">
            <button type="submit" class="primary-pill">Guardar contraseña</button>
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
