@page
@model VentaMap.Pages.Account.ForgotPasswordModel
@{
    ViewData["Title"] = "Recuperar contraseña";
}

<section class="form-shell narrow">
    <div class="section-heading">
        <span class="eyebrow">Acceso</span>
        <h1>Recuperar contraseña</h1>
        <p>Ingresá tu email y te enviamos un enlace para blanquear la contraseña.</p>
    </div>

    <form method="post" class="stack-form">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
        {
            <div class="status-banner warning">@Model.StatusMessage</div>
        }
        <div class="register-row">
            <label>
                <span>Email</span>
                <input asp-for="Input.Email" />
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </label>
        </div>
        <div class="hero-actions">
            <button type="submit" class="primary-pill">Enviar enlace</button>
            <a class="ghost-pill" asp-page="/Account/Login">Volver al ingreso</a>
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
