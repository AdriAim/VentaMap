@page
@model VentaMap.Pages.Account.BillingModel
@using VentaMap.Services
@{
    ViewData["Title"] = "Pagos mensuales";
}

<section class="form-shell narrow">
    <div class="section-heading">
        <span class="eyebrow">Cuenta</span>
        <h1>Pagos mensuales</h1>
        @if (Model.UserAccount?.IsBillingExempt == 1)
        {
            <p>Tu cuenta está marcada como gratuita: no se generan cargos por anuncios ni catálogo.</p>
        }
        else if (Model.UserAccount?.Id == BillingService.CompanyWithoutTrialUserId)
        {
            <p>El plan empresa cuesta @Model.CurrentCompanyMonthlyAmountText por cada mes con anuncios activos.</p>
        }
        else if (Model.UserAccount?.IsCompany == true)
        {
            <p>Los primeros 3 meses desde tu primera publicación son gratuitos. Desde el cuarto mes, el plan empresa cuesta @Model.CurrentCompanyMonthlyAmountText por cada mes con anuncios activos.</p>
        }
        else
        {
            <p>Anuncio básico: hasta 3 fotos y sin video. Anuncio completo: hasta 10 fotos, video incluido y @Model.CurrentPersonPublicationAmountText.</p>
        }
    </div>

    @if (!Model.MonthlyPeriods.Any())
    {
        <section class="empty-state"><h2>Tu historial mensual aparecerá desde que publiques tu primer anuncio.</h2></section>
    }
    else
    {
        <section class="detail-panel">
            <div class="table-responsive"><table class="table">
                <thead><tr><th>Período</th><th>Concepto</th><th>Importe</th><th>Estado</th><th></th></tr></thead>
                <tbody>
                @foreach (var period in Model.MonthlyPeriods)
                {
                    <tr>
                        <td>@period.MonthUtc.ToString("MMMM yyyy", new System.Globalization.CultureInfo("es-AR"))</td>
                        <td>@(period.HasActivePublication || period.Charge is not null ? "Plan empresa mensual" : "Sin anuncios activos")</td>
                        <td>@(period.Charge is not null ? $"${period.Charge.Amount.ToString("N0", new System.Globalization.CultureInfo("es-AR"))}" : period.IsFree ? "GRATIS" : "SIN CARGO")</td>
                        <td>@(period.Charge?.Status switch { "Paid" => "Pagado", "Used" => "Pagado y aplicado", null when period.IsFree => "GRATIS", null => "Sin cargo", _ => "Pendiente" })</td>
                        <td>
                            @if (period.Charge?.Status == "Pending")
                            {
                                <button type="button" class="primary-pill compact" data-mercadopago-checkout="@period.Charge.Id">Pagar con Mercado Pago</button>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table></div>
        </section>
    }

    @if (Model.Charges.Any(x => x.Status == "Pending"))
    {
        <section class="status-banner">
            @if (Model.IsMercadoPagoConfigured)
            {
                <span>Elegí un cargo y presioná “Pagar con Mercado Pago”. Al acreditarse, se actualizará automáticamente.</span>
            }
            else
            {
                <span>Los cargos ya están registrados. Falta conectar Mercado Pago para mostrar el QR y el botón de pago.</span>
            }
        </section>
    }

    @if (Model.HasOverdueMonthlyDebt)
    {
        <section class="status-banner warning">
            Tenés un pago mensual pendiente vencido. Hasta regularizarlo no podrás dar de alta ni republicar anuncios.
        </section>
    }
</section>

@section Scripts {
<script>
document.querySelectorAll('[data-mercadopago-checkout]').forEach(button => {
  button.addEventListener('click', async () => {
    button.disabled = true;
    const response = await fetch(`/api/payments/mercadopago/checkout/${button.dataset.mercadopagoCheckout}`, { method: 'POST' });
    const result = await response.json().catch(() => ({}));
    if (response.ok && result.checkoutUrl) {
      window.location.assign(result.checkoutUrl);
      return;
    }
    button.disabled = false;
    window.alert(result.message || 'No se pudo iniciar el pago.');
  });
});
</script>
}
