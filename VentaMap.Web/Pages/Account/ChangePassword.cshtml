@page
@model VentaMap.Pages.Account.ChangePasswordModel
@{
    ViewData["Title"] = "Cambiar contrasena";
}

<section class="form-shell narrow">
    <div class="section-heading">
        <span class="eyebrow">Cuenta</span>
        <h1>Cambiar contrasena</h1>
        <p>Actualiza la contrasena de acceso de tu usuario.</p>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
    {
        <div class="status-banner success-banner">@Model.SuccessMessage</div>
    }

    <form method="post" class="stack-form">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <label>
            <span>Contrasena actual</span>
            <input asp-for="Input.CurrentPassword" type="password" autocomplete="current-password" />
            <span asp-validation-for="Input.CurrentPassword" class="text-danger"></span>
        </label>

        <label>
            <span>Nueva contrasena</span>
            <input asp-for="Input.NewPassword" type="password" autocomplete="new-password" />
            <span asp-validation-for="Input.NewPassword" class="text-danger"></span>
        </label>

        <label>
            <span>Repetir nueva contrasena</span>
            <input asp-for="Input.ConfirmPassword" type="password" autocomplete="new-password" />
            <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
        </label>

        <div class="hero-actions">
            <button type="submit" class="primary-pill">Guardar contrasena</button>
            <a class="ghost-pill" asp-page="/Index">Volver</a>
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
