@page "/Monitor/Panel"
@model VentaMap.Pages.Monitor.PanelModel
@using System.Globalization
@{
    ViewData["Title"] = "Monitor";
    var argentinaCulture = CultureInfo.GetCultureInfo("es-AR");
}

<section class="form-shell">
    <div class="section-heading">
        <span class="eyebrow">Monitor</span>
        <h1>Métricas diarias</h1>
        <p>Últimos 30 días. Se excluyen cuentas y anuncios de depuración.</p>
    </div>
    <section class="detail-panel monitor-suggestions" data-monitor-suggestions data-last-suggestion-id="@Model.LatestSuggestionId">
        <div class="section-heading">
            <span class="eyebrow">Alertas</span>
            <h2>Sugerencias del sitio</h2>
            <p>Este panel avisa automáticamente cuando llega una nueva sugerencia.</p>
        </div>
        <div class="status-banner success-banner" data-suggestion-alert role="alert" hidden></div>
        <div class="monitor-suggestions-list" data-suggestion-list aria-live="polite">
            @if (!Model.RecentSuggestions.Any())
            {
                <p class="field-hint" data-suggestion-empty>Aún no hay sugerencias.</p>
            }
            @foreach (var suggestion in Model.RecentSuggestions)
            {
                var sender = suggestion.SenderName ?? suggestion.User?.Name ?? "Anónimo";
                var email = suggestion.SenderEmail ?? suggestion.User?.Email;
                <article class="monitor-suggestion" data-suggestion-id="@suggestion.Id">
                    <strong>@sender</strong>
                    @if (!string.IsNullOrWhiteSpace(email))
                    {
                        <span>@email</span>
                    }
                    <time datetime="@suggestion.CreatedAtUtc.ToString("O")">@suggestion.CreatedAtUtc.AddHours(-3).ToString("dd/MM/yyyy HH:mm")</time>
                    <p>@suggestion.Message</p>
                </article>
            }
        </div>
    </section>
    <section class="detail-panel">
        <div class="table-responsive">
            <table class="table">
                <thead>
                    <tr>
                        <th rowspan="2">Día</th><th rowspan="2">Usuarios registrados</th><th rowspan="2">Anuncios nuevos</th><th rowspan="2">Anuncios republicados</th>
                        <th colspan="3">Campañas de redes</th>
                        <th rowspan="2">Enlaces compartidos</th><th rowspan="2">Resto de ingresos</th><th rowspan="2">Total visitantes</th>
                    </tr>
                    <tr>
                        <th>Instagram</th><th>Facebook</th><th>Total redes</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var item in Model.Metrics)
                {
                    <tr>
                        <td>@item.Day.ToString("dd/MM/yyyy")</td>
                        <td>
                            @if (item.NewUsers.Count > 0)
                            {
                                <span class="monitor-metric-cell monitor-metric-cell--start" tabindex="0">
                                    @item.RegisteredUsers
                                    <span class="monitor-metric-tooltip" role="tooltip">
                                        <strong>Usuarios nuevos</strong>
                                        @foreach (var user in item.NewUsers)
                                        {
                                            <span><b>@user.Name</b><small>@user.Email</small></span>
                                        }
                                    </span>
                                </span>
                            }
                            else { @item.RegisteredUsers }
                        </td>
                        <td>
                            @if (item.NewPublications.Count > 0)
                            {
                                <span class="monitor-metric-cell" tabindex="0" role="button" aria-expanded="false" data-monitor-tooltip-trigger>
                                    @item.NewPublications.Count
                                    <span class="monitor-metric-tooltip" role="tooltip">
                                        <strong>Anuncios nuevos</strong>
                                        @foreach (var publication in item.NewPublications)
                                        {
                                            <span>
                                                <b>@publication.UserName</b>
                                                <small>@publication.ShortDescription</small>
                                                <small>@publication.Locality · @publication.Currency @publication.Price.ToString("N0", argentinaCulture)</small>
                                                <small>@publication.CreatedAtUtc.AddHours(-3).ToString("dd/MM/yyyy HH:mm")</small>
                                            </span>
                                        }
                                    </span>
                                </span>
                            }
                            else { @item.NewPublications.Count }
                        </td>
                        <td>@item.RepublishedPublications</td>
                        <td>
                            @if (item.InstagramCampaignVisitors > 0)
                            {
                                <span class="monitor-metric-cell" tabindex="0" role="button" aria-expanded="false" data-monitor-tooltip-trigger>
                                    @item.InstagramCampaignVisitors
                                    <span class="monitor-metric-tooltip" role="tooltip">
                                        <strong>Campañas de Instagram</strong>
                                        @foreach (var campaign in item.InstagramCampaigns)
                                        {
                                            <span><b>@campaign.Name</b><small>@campaign.Visitors visitantes</small></span>
                                        }
                                    </span>
                                </span>
                            }
                            else { @item.InstagramCampaignVisitors }
                        </td>
                        <td>
                            @if (item.FacebookCampaignVisitors > 0)
                            {
                                <span class="monitor-metric-cell" tabindex="0">
                                    @item.FacebookCampaignVisitors
                                    <span class="monitor-metric-tooltip" role="tooltip">
                                        <strong>Campañas de Facebook</strong>
                                        @foreach (var campaign in item.FacebookCampaigns)
                                        {
                                            <span><b>@campaign.Name</b><small>@campaign.Visitors visitantes</small></span>
                                        }
                                    </span>
                                </span>
                            }
                            else { @item.FacebookCampaignVisitors }
                        </td>
                        <td>@item.SocialCampaignVisitors</td>
                        <td>@item.SharedLinkVisitors</td>
                        <td>@item.OtherVisitors</td>
                        <td>@item.Visitors</td>
                    </tr>
                }
                </tbody>
                <tfoot>
                    <tr>
                        <th colspan="4">Total de los últimos 30 días</th>
                        <th>@Model.Metrics.Sum(x => x.InstagramCampaignVisitors)</th>
                        <th>@Model.Metrics.Sum(x => x.FacebookCampaignVisitors)</th>
                        <th>@Model.Metrics.Sum(x => x.SocialCampaignVisitors)</th>
                        <th>@Model.Metrics.Sum(x => x.SharedLinkVisitors)</th>
                        <th>@Model.Metrics.Sum(x => x.OtherVisitors)</th>
                        <th>@Model.Metrics.Sum(x => x.Visitors)</th>
                    </tr>
                </tfoot>
            </table>
        </div>
    </section>
</section>

@section Scripts {
    <script>
        (() => {
            const closeTooltips = except => {
                document.querySelectorAll('[data-monitor-tooltip-trigger].is-tooltip-open').forEach((trigger) => {
                    if (trigger === except) return;
                    trigger.classList.remove('is-tooltip-open');
                    trigger.setAttribute('aria-expanded', 'false');
                });
            };

            const toggleTooltip = trigger => {
                const open = !trigger.classList.contains('is-tooltip-open');
                closeTooltips(trigger);
                trigger.classList.toggle('is-tooltip-open', open);
                trigger.setAttribute('aria-expanded', String(open));
            };

            document.addEventListener('click', event => {
                const trigger = event.target.closest('[data-monitor-tooltip-trigger]');
                if (trigger) {
                    toggleTooltip(trigger);
                    return;
                }
                closeTooltips();
            });

            document.addEventListener('keydown', event => {
                const trigger = event.target.closest('[data-monitor-tooltip-trigger]');
                if (!trigger || !['Enter', ' '].includes(event.key)) return;
                event.preventDefault();
                toggleTooltip(trigger);
            });
        })();

        (() => {
            const panel = document.querySelector('[data-monitor-suggestions]');
            if (!panel) return;

            const list = panel.querySelector('[data-suggestion-list]');
            const alert = panel.querySelector('[data-suggestion-alert]');
            let lastId = Number(panel.dataset.lastSuggestionId || 0);

            const formatDate = (value) => new Intl.DateTimeFormat('es-AR', {
                dateStyle: 'short', timeStyle: 'short', timeZone: 'America/Argentina/Buenos_Aires'
            }).format(new Date(value));

            const renderSuggestion = (suggestion) => {
                const article = document.createElement('article');
                article.className = 'monitor-suggestion';
                article.dataset.suggestionId = suggestion.id;

                const sender = document.createElement('strong');
                sender.textContent = suggestion.senderName || 'Anónimo';
                article.appendChild(sender);

                if (suggestion.senderEmail) {
                    const email = document.createElement('span');
                    email.textContent = suggestion.senderEmail;
                    article.appendChild(email);
                }

                const time = document.createElement('time');
                time.dateTime = suggestion.createdAtUtc;
                time.textContent = formatDate(suggestion.createdAtUtc);
                article.appendChild(time);

                const message = document.createElement('p');
                message.textContent = suggestion.message;
                article.appendChild(message);
                return article;
            };

            const checkForSuggestions = async () => {
                try {
                    const response = await fetch(`?handler=Suggestions&afterId=${lastId}`, {
                        headers: { Accept: 'application/json' }, credentials: 'same-origin'
                    });
                    if (!response.ok) return;

                    const suggestions = await response.json();
                    if (!suggestions.length) return;

                    const empty = list.querySelector('[data-suggestion-empty]');
                    empty?.remove();
                    suggestions.forEach((suggestion) => {
                        list.prepend(renderSuggestion(suggestion));
                        lastId = Math.max(lastId, suggestion.id);
                    });
                    alert.textContent = suggestions.length === 1
                        ? 'Nueva sugerencia recibida.'
                        : `${suggestions.length} nuevas sugerencias recibidas.`;
                    alert.hidden = false;
                } catch {
                    // El próximo ciclo vuelve a intentar sin interrumpir el monitor.
                }
            };

            window.setInterval(checkForSuggestions, 15000);
        })();
    </script>
}
