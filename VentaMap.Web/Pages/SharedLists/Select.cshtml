@page "/MisListasCompartibles/Seleccionar/{id:int}"
@using System.Text.Json
@using VentaMap.Models
@inject IConfiguration Configuration
@model VentaMap.Pages.SharedLists.SelectModel
@{
    ViewData["Title"] = "Seleccionar anuncios";
    string FormatMapPrice(VentaMap.Models.Publication publication, string numericFormat)
    {
        var period = publication.OperationType?.ToDisplayName() switch
        {
            "Alquiler" => " / mes",
            "Temporario" => " / día",
            _ => string.Empty
        };

        return $"{publication.Currency} {publication.Price.ToString(numericFormat, System.Globalization.CultureInfo.GetCultureInfo("es-AR"))}{period}";
    }
    var markersJson = JsonSerializer.Serialize(Model.AvailablePublications
        .Where(x => x.Publication.Latitude.HasValue && x.Publication.Longitude.HasValue && !x.Publication.HideFromMap)
        .Select(x => new
        {
            id = x.Publication.Id,
            title = x.Publication.Title,
            shortDescription = x.Publication.ShortDescription,
            locality = x.Publication.Locality,
            image = x.Publication.ImageList.FirstOrDefault(),
            images = x.Publication.ImageList.Take(11).ToList(),
            operationLabel = x.Publication.OperationType?.ToDisplayName(),
            categoryLabel = x.Publication.Category?.Name,
            detailsUrl = $"/Publications/Details/{x.Publication.Id}",
            lat = x.Publication.Latitude,
            lng = x.Publication.Longitude,
            price = FormatMapPrice(x.Publication, "N0"),
            priceTooltip = FormatMapPrice(x.Publication, "N0")
        }));
    var availableCategories = Model.AvailablePublications
        .Select(x => x.Publication.Category?.Name)
        .Where(x => !string.IsNullOrWhiteSpace(x))
        .Select(x => x!)
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(x => x)
        .ToList();
    string ModeUrl(string mode) => Url.Page("/SharedLists/Select", new { id = Model.SharedList!.Id, mode })!;
    var resultsShell = Model.SharedList is null
        ? null
        : new ResultsShellViewModel
        {
            Kicker = $"Vista {Model.Mode.ToLowerInvariant()}",
            Title = "Anuncios disponibles",
            CurrentMode = Model.Mode,
            TextViewUrl = ModeUrl("Lista"),
            GalleryViewUrl = ModeUrl("Galeria"),
            MapViewUrl = ModeUrl("Mapa"),
            MapStyleUrl = Configuration["Map:StyleUrl"] ?? string.Empty,
            MapTilesUrlTemplate = Configuration["Map:TilesUrlTemplate"] ?? string.Empty,
            MapAttributionHtml = Configuration["Map:AttributionHtml"] ?? string.Empty,
            MarkersJson = markersJson,
            MapSelectionAction = "shared-list",
            MapSelectionDescription = "Volvé a Lista o Galería para marcarlo y agregarlo a la lista.",
            MapPlaceholderTitle = "Mapa no disponible",
            MapPlaceholderMessage = "Configurá el proveedor de mapas para usar esta vista."
        };
}

@if (Model.SharedList is not null)
{
    var selectedCount = Model.SelectedPublications.Count;
    var availableCount = Model.AvailablePublications.Count;

    <section class="favorites-strip favorites-page-strip">
        <div class="favorites-strip-copy">
            <span class="eyebrow">Editar lista compartible</span>
            <h2>Lista: @Model.SharedList.Name</h2>
        </div>
        <div class="favorites-strip-actions">
            <a class="ghost-pill" asp-page="/SharedLists/Manage">Volver a mis listas</a>
            <a class="primary-pill" href="/Listas/@Model.SharedList.User?.CompanySlug/@Model.SharedList.Slug" target="_blank" rel="noopener noreferrer">Ver lista pública</a>
        </div>
    </section>

    @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
    {
        <div class="status-banner success-banner">@Model.SuccessMessage</div>
    }
    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="status-banner danger-banner">@Model.ErrorMessage</div>
    }

    <div class="company-share-selection-layout">
        <aside class="company-share-selected-panel">
            <div class="company-share-selected-head">
                <div>
                    <span class="eyebrow">Seleccionados</span>
                    <h2>@selectedCount anuncio(s) en esta lista</h2>
                </div>
                <div class="company-share-selected-stats" aria-label="Resumen de anuncios">
                    <span><strong>@Model.ActivePublicationCount</strong> activos</span>
                    <span><strong>@availableCount</strong> disponibles para agregar</span>
                </div>
                @if (Model.SelectedPublications.Any())
                {
                    <form method="post"
                          asp-page-handler="Clear"
                          asp-route-id="@Model.SharedList.Id"
                          data-company-share-ajax-form="true"
                          onsubmit="return confirm('¿Quitar todos los anuncios de esta lista?');">
                        <input type="hidden" name="mode" value="@Model.Mode" />
                        <button type="submit" class="danger-pill">Quitar todos</button>
                    </form>
                }
            </div>

            @if (!Model.SelectedPublications.Any())
            {
                <div class="company-share-selected-empty">
                    Todavía no agregaste anuncios a esta lista.
                </div>
            }
            else
            {
                <div class="company-share-selected-grid">
                    @foreach (var publication in Model.SelectedPublications)
                    {
                        var imageUrl = publication.ImageList.FirstOrDefault();
                        <article class="company-share-selected-item">
                            <a class="company-share-selected-media" href="/Publications/Details/@publication.Id" target="_blank" rel="noopener noreferrer">
                                @if (!string.IsNullOrWhiteSpace(imageUrl))
                                {
                                    <img src="@imageUrl" alt="@publication.Title" />
                                }
                                else
                                {
                                    <div class="publication-admin-placeholder">Sin imagen</div>
                                }
                            </a>
                            <div class="company-share-selected-copy">
                                <span class="gallery-kicker">@(publication.Category?.Name ?? "Sin categoría")</span>
                                <strong>@publication.Title</strong>
                                <span>@(string.IsNullOrWhiteSpace(publication.Locality) ? "Sin ubicación pública" : publication.Locality)</span>
                            </div>
                            <form method="post" asp-page-handler="Remove" asp-route-id="@Model.SharedList.Id" asp-route-publicationId="@publication.Id" data-company-share-ajax-form="true">
                                <input type="hidden" name="mode" value="@Model.Mode" />
                                <button type="submit" class="danger-pill">Quitar</button>
                            </form>
                        </article>
                    }
                </div>
            }
        </aside>

        <div class="company-share-available-panel">
            <section class="search-panel company-share-selection-search">
                <div class="section-heading">
                    <span class="eyebrow">Agregar anuncios</span>
                    <h2>Marcá entre los @availableCount anuncio(s) disponibles</h2>
                </div>
                <div class="search-grid search-grid-minimal" data-company-share-search-form>
                    <label class="search-control search-query-control">
                        <span class="search-control-label">Qué buscás</span>
                        <input type="search" autocomplete="off" placeholder="Ej. departamento, oficina, auto" data-company-share-search />
                    </label>
                    <label class="search-control">
                        <span class="search-control-label">Grupo</span>
                        <select data-company-share-group>
                            <option value="">Todos</option>
                            <option value="Inmuebles">Inmuebles</option>
                            <option value="Rodados">Rodados</option>
                            <option value="Embarcaciones">Embarcaciones</option>
                            <option value="Agro">Agro</option>
                            <option value="Electronica">Electronica</option>
                            <option value="Generales">Generales</option>
                            <option value="Moda">Moda</option>
                        </select>
                    </label>
                    <label class="search-control">
                        <span class="search-control-label">Categoría</span>
                        <select data-company-share-category>
                            <option value="">Todas</option>
                            @foreach (var category in availableCategories)
                            {
                                <option value="@category">@category</option>
                            }
                        </select>
                    </label>
                    <button type="button" class="primary-pill large search-submit-control" data-company-share-search-submit>Buscar</button>
                </div>
            </section>

            <partial name="~/Views/Content/Results/_ResultsShellHeader.cshtml" model="resultsShell" />

            <form method="post" asp-page-handler="Add" asp-route-id="@Model.SharedList.Id" data-company-share-ajax-form="true" data-company-share-add-form="true">
        <input type="hidden" name="mode" value="@Model.Mode" />
        @if (Model.Mode != "Mapa")
        {
            <section class="classified-toolbar company-share-selection-actions">
                <div class="classified-summary" data-selection-count>0 marcados para agregar</div>
                <button type="button" class="ghost-pill" data-company-share-select-all>Seleccionar todos</button>
                <button type="button" class="ghost-pill" data-company-share-clear-selection>Deseleccionar todos</button>
                <button type="submit" class="danger-pill company-share-add-selected-button">Agregar seleccionados</button>
            </section>
        }

        @if (!Model.AvailablePublications.Any())
        {
            <section class="empty-state">
                <h2>No hay más anuncios activos para agregar.</h2>
            </section>
        }
        else if (Model.Mode == "Lista")
        {
            <section class="publication-admin-list">
                @foreach (var item in Model.AvailablePublications)
                {
                    var publication = item.Publication;
                    var imageUrl = publication.ImageList.FirstOrDefault();
                    <label class="publication-admin-card company-share-select-card company-share-catalog-select" data-company-share-item="true" data-company-share-group="@publication.Group" data-company-share-category="@(publication.Category?.Name ?? string.Empty)" data-company-share-text="@publication.Title @(publication.Category?.Name ?? string.Empty) @publication.Locality @publication.ShortDescription">
                        <input type="checkbox" name="publicationIds" value="@publication.Id" data-company-share-checkbox />
                        <div class="publication-admin-media">
                            @if (!string.IsNullOrWhiteSpace(imageUrl))
                            {
                                <img src="@imageUrl" alt="@publication.Title" />
                            }
                            else
                            {
                                <div class="publication-admin-placeholder">Sin imagen</div>
                            }
                        </div>
                        <div class="publication-admin-body">
                            <div class="publication-admin-head">
                                <div>
                                    <span class="gallery-kicker">@(publication.Category?.Name ?? "Sin categoría")</span>
                                    <h3>@publication.Title</h3>
                                </div>
                            </div>
                            <p class="publication-admin-price">@publication.Currency @publication.Price.ToString("0")</p>
                            <p>@publication.ShortDescription</p>
                            <div class="publication-admin-meta">
                                <span>@(string.IsNullOrWhiteSpace(publication.Locality) ? "Sin ubicación pública" : publication.Locality)</span>
                                <span>Publicado: @publication.CreatedAtUtc.ToLocalTime().ToString("dd/MM/yyyy")</span>
                            </div>
                            <div class="publication-admin-actions">
                                <span class="field-hint">Marcá para agregar a la lista</span>
                            </div>
                        </div>
                    </label>
                }
            </section>
        }
        else if (Model.Mode == "Galeria")
        {
            <section class="gallery-feed">
                <div class="gallery-rail company-share-gallery-rail">
                    @foreach (var item in Model.AvailablePublications)
                    {
                        var publication = item.Publication;
                        var imageUrl = publication.ImageList.FirstOrDefault();
                        <label class="listing-card company-share-select-card" data-company-share-item="true" data-company-share-group="@publication.Group" data-company-share-category="@(publication.Category?.Name ?? string.Empty)" data-company-share-text="@publication.Title @(publication.Category?.Name ?? string.Empty) @publication.Locality @publication.ShortDescription">
                            <input type="checkbox" name="publicationIds" value="@publication.Id" data-company-share-checkbox />
                            <div class="card-image-wrap">
                                @if (!string.IsNullOrWhiteSpace(imageUrl))
                                {
                                    <img src="@imageUrl" alt="@publication.Title" />
                                }
                                else
                                {
                                    <div class="publication-admin-placeholder">Sin imagen</div>
                                }
                                <span class="card-group">@(publication.Category?.Name ?? "Sin categoría")</span>
                            </div>
                            <div class="listing-card-copy">
                                <h3>@publication.Title</h3>
                                <span class="gallery-description-tooltip gallery-tooltip-trigger" data-tooltip-label="@(publication.Title + "\n" + publication.ShortDescription)" tabindex="0"><span>@(string.IsNullOrWhiteSpace(publication.ShortDescription) ? publication.Title : publication.ShortDescription)</span></span>
                                <strong>@publication.Currency @publication.Price.ToString("0")</strong>
                                <span>@publication.Locality</span>
                            </div>
                        </label>
                    }
                </div>
            </section>
        }
        else
        {
            <partial name="~/Views/Content/Results/_ResultsMapShell.cshtml" model="resultsShell" />
        }
            </form>
        </div>
    </div>
}

@section Scripts {
    <script>
        (() => {
            const wireSelectionLayout = (root = document) => {
                const layout = root.querySelector(".company-share-selection-layout");
                if (!layout || layout.dataset.companyShareSelectionBound === "true") return;
                layout.dataset.companyShareSelectionBound = "true";

                const search = layout.querySelector("[data-company-share-search]");
                const group = layout.querySelector("[data-company-share-group]");
                const category = layout.querySelector("[data-company-share-category]");
                const searchButton = layout.querySelector("[data-company-share-search-submit]");
                const selectAllButton = layout.querySelector("[data-company-share-select-all]");
                const clearSelectionButton = layout.querySelector("[data-company-share-clear-selection]");
                const cards = Array.from(layout.querySelectorAll("[data-company-share-item='true']"));
                const count = layout.querySelector("[data-selection-count]");

                const refresh = () => {
                    const selected = layout.querySelectorAll("[data-company-share-checkbox]:checked").length;
                    if (count) {
                        count.textContent = `${selected} marcado${selected === 1 ? "" : "s"} para agregar`;
                    }
                };

                const applyFilters = () => {
                    const query = (search?.value || "").toLowerCase().trim();
                    const selectedGroup = group?.value || "";
                    const selectedCategory = category?.value || "";
                    cards.forEach(card => {
                        const matchesText = !query || (card.getAttribute("data-company-share-text") || "").toLowerCase().includes(query);
                        const matchesGroup = !selectedGroup || card.getAttribute("data-company-share-group") === selectedGroup;
                        const matchesCategory = !selectedCategory || card.getAttribute("data-company-share-category") === selectedCategory;
                        card.hidden = !(matchesText && matchesGroup && matchesCategory);
                    });
                };

                search?.addEventListener("input", applyFilters);
                group?.addEventListener("change", applyFilters);
                category?.addEventListener("change", applyFilters);
                searchButton?.addEventListener("click", applyFilters);
                selectAllButton?.addEventListener("click", () => {
                    cards.forEach(card => {
                        if (card.hidden) return;
                        const checkbox = card.querySelector("[data-company-share-checkbox]");
                        if (checkbox) checkbox.checked = true;
                    });
                    refresh();
                });
                clearSelectionButton?.addEventListener("click", () => {
                    layout.querySelectorAll("[data-company-share-checkbox]:checked").forEach(checkbox => {
                        checkbox.checked = false;
                    });
                    refresh();
                });
                layout.addEventListener("change", event => {
                    if (event.target.matches("[data-company-share-checkbox]")) refresh();
                });

                refresh();
            };

            wireSelectionLayout();

            document.addEventListener("submit", async event => {
                const form = event.target.closest("[data-company-share-ajax-form='true']");
                if (!form) return;
                if (event.defaultPrevented) return;

                event.preventDefault();

                if (form.matches("[data-company-share-add-form='true']") && !form.querySelector("[data-company-share-checkbox]:checked")) {
                    return;
                }

                const submitButton = form.querySelector("button[type='submit']");
                const originalLabel = submitButton?.textContent || "";
                if (submitButton) {
                    submitButton.disabled = true;
                    submitButton.textContent = "Guardando...";
                }

                try {
                    const response = await fetch(form.getAttribute("action") || window.location.href, {
                        method: "POST",
                        headers: {
                            "X-Requested-With": "XMLHttpRequest"
                        },
                        body: new FormData(form)
                    });
                    const html = await response.text();
                    if (!response.ok) {
                        throw new Error("No se pudo actualizar la lista.");
                    }

                    const nextDocument = new DOMParser().parseFromString(html, "text/html");
                    const currentLayout = document.querySelector(".company-share-selection-layout");
                    const nextLayout = nextDocument.querySelector(".company-share-selection-layout");
                    if (!currentLayout || !nextLayout) {
                        window.location.reload();
                        return;
                    }

                    currentLayout.replaceWith(nextLayout);
                    wireSelectionLayout(document);
                    window.dispatchEvent(new CustomEvent("ventamap:content-updated"));
                } catch {
                    if (submitButton) {
                        submitButton.disabled = false;
                        submitButton.textContent = originalLabel || "Reintentar";
                    }
                    alert("No se pudo actualizar la lista. Intenta nuevamente.");
                }
            });
        })();
    </script>
}
