@page "/MisListasCompartibles"
@model VentaMap.Pages.SharedLists.ManageModel
@{
    ViewData["Title"] = "Listas de anuncios para compartir";
}

<section class="favorites-strip favorites-page-strip">
    <div class="favorites-strip-copy">
        <h2>Listas de anuncios para compartir</h2>
    </div>
    <div class="favorites-strip-actions">
        <div class="company-share-create-panel">
            <span class="gallery-kicker">Crear nueva lista</span>
            <form method="post" asp-page-handler="Create" class="company-share-create-form">
                <input type="text" name="listName" maxlength="120" required placeholder="@Model.CreateListPlaceholder" />
                <button type="submit" class="primary-pill">Crear lista</button>
            </form>
        </div>
    </div>
</section>

@if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
{
    <div class="status-banner success-banner">@Model.SuccessMessage</div>
}
@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="status-banner danger-banner">@Model.ErrorMessage</div>
}

@if (!Model.SharedLists.Any())
{
    <section class="empty-state">
        <h2>Todavía no creaste listas.</h2>
        <p>Creá una lista para seleccionar anuncios activos y compartir un único link.</p>
    </section>
}
else
{
    <section class="favorites-strip favorites-page-strip company-publications-strip"
             data-shared-lists-toolbar="true">
        <div class="favorites-strip-copy">
            <span class="eyebrow">Buscar listas</span>
            <h2>Mis listas compartibles</h2>
        </div>
        <div class="company-catalog-toolbar-controls">
            <label class="company-catalog-search">
                <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
                <input type="search"
                       placeholder="Buscar por nombre o link"
                       autocomplete="off"
                       data-shared-lists-search />
            </label>
        </div>
        <div class="my-publications-filter-meta">
            <span class="field-hint" data-shared-lists-count>@Model.SharedLists.Count lista(s) visibles</span>
        </div>
    </section>

    <section class="publication-admin-list publication-admin-list-shared company-share-list-index" data-shared-lists-results="true">
        @foreach (var list in Model.SharedLists)
        {
            <article class="publication-admin-card"
                     data-shared-list-item="true"
                     data-shared-list-search="@($"{list.Name} {list.ItemCount} anuncios {list.ShareUrl}")">
                <div class="publication-admin-body">
                    <div class="publication-admin-head">
                        <div class="publication-admin-summary">
                            <div>
                                <h3>Lista: @list.Name</h3>
                            </div>
                            <span class="publication-admin-status is-active">@list.ItemCount anuncio(s)</span>
                        </div>
                    </div>
                    <div class="publication-admin-actions">
                        <form method="post"
                              asp-page-handler="DefaultMode"
                              asp-route-listId="@list.Id"
                              class="company-share-default-mode-form"
                              data-shared-list-default-mode-form="true">
                            <label>
                                <span>Vista por defecto</span>
                                <select name="defaultMode" data-shared-list-default-mode-select>
                                    <option value="Lista" selected="@(list.DefaultMode == "Lista")">Lista</option>
                                    <option value="Galeria" selected="@(list.DefaultMode == "Galeria")">Galería</option>
                                    <option value="Mapa" selected="@(list.DefaultMode == "Mapa")">Mapa</option>
                                </select>
                            </label>
                            <span class="company-share-default-mode-status" data-shared-list-default-mode-status aria-live="polite"></span>
                        </form>
                        <a class="primary-pill company-share-select-button" asp-page="/SharedLists/Select" asp-route-id="@list.Id">Seleccionar anuncios</a>
                        <a class="ghost-pill company-share-public-button" href="@list.ShareUrl" target="_blank" rel="noopener noreferrer">Ver lista pública</a>
                        <button type="button"
                                class="ghost-pill publication-share-link"
                                data-copy-shared-list-link="true"
                                data-copy-url="@list.ShareUrl">
                            <i class="fa-solid fa-share-nodes" aria-hidden="true"></i>
                            <span>Copiar link para compartir</span>
                        </button>
                        <form method="post" asp-page-handler="Delete" asp-route-listId="@list.Id" onsubmit="return confirm('Esta acción eliminará la lista compartible.');">
                            <button type="submit" class="danger-pill">Eliminar</button>
                        </form>
                    </div>
                </div>
            </article>
        }
    </section>
    <section class="empty-state" data-shared-lists-empty="true" hidden>
        <h2>No hay listas que coincidan.</h2>
        <p>Prueba otra búsqueda.</p>
    </section>
}

@section Scripts {
    <script>
        (() => {
            const toolbar = document.querySelector("[data-shared-lists-toolbar='true']");
            const results = document.querySelector("[data-shared-lists-results='true']");
            if (!toolbar || !results) return;

            const searchInput = toolbar.querySelector("[data-shared-lists-search]");
            const countNode = toolbar.querySelector("[data-shared-lists-count]");
            const emptyState = document.querySelector("[data-shared-lists-empty='true']");
            const items = Array.from(results.querySelectorAll("[data-shared-list-item='true']"));

            const normalize = value => String(value || "")
                .normalize("NFD")
                .replace(/[\u0300-\u036f]/g, "")
                .toLowerCase()
                .trim();

            const applySearch = () => {
                const query = normalize(searchInput?.value);
                let visibleCount = 0;

                items.forEach(item => {
                    const isVisible = !query || normalize(item.dataset.sharedListSearch).includes(query);
                    item.hidden = !isVisible;
                    if (isVisible) visibleCount += 1;
                });

                if (countNode) {
                    countNode.textContent = `${visibleCount} lista(s) visibles`;
                }

                if (emptyState) {
                    emptyState.hidden = visibleCount > 0;
                }
            };

            searchInput?.addEventListener("input", applySearch);
            applySearch();
        })();

        (() => {
            const forms = Array.from(document.querySelectorAll("[data-shared-list-default-mode-form='true']"));
            forms.forEach(form => {
                const select = form.querySelector("[data-shared-list-default-mode-select]");
                const status = form.querySelector("[data-shared-list-default-mode-status]");
                let lastValue = select?.value || "Galeria";

                select?.addEventListener("change", async () => {
                    const nextValue = select.value;
                    const formData = new FormData(form);
                    if (status) status.textContent = "Guardando...";
                    select.disabled = true;

                    try {
                        const response = await fetch(form.getAttribute("action") || window.location.href, {
                            method: "POST",
                            headers: {
                                "Accept": "application/json",
                                "X-Requested-With": "XMLHttpRequest"
                            },
                            body: formData
                        });
                        const payload = await response.json().catch(() => null);

                        if (!response.ok || !payload?.success) {
                            throw new Error(payload?.message || "No se pudo guardar");
                        }

                        lastValue = payload.defaultMode || nextValue;
                        if (status) status.textContent = "Guardado";
                    } catch {
                        select.value = lastValue;
                        if (status) status.textContent = "No se pudo guardar";
                    } finally {
                        select.disabled = false;
                        window.setTimeout(() => {
                            if (status) status.textContent = "";
                        }, 1800);
                    }
                });
            });
        })();

        (() => {
            document.addEventListener("click", async event => {
                const button = event.target.closest("[data-copy-shared-list-link='true']");
                if (!button) return;

                const rawUrl = button.getAttribute("data-copy-url") || "";
                if (!rawUrl) return;

                const label = button.querySelector("span");
                const originalLabel = label?.textContent || "Copiar link para compartir";
                try {
                    const shareUrl = new URL(rawUrl, window.location.origin).toString();
                    if (navigator.clipboard?.writeText) {
                        await navigator.clipboard.writeText(shareUrl);
                    } else {
                        const helper = document.createElement("textarea");
                        helper.value = shareUrl;
                        helper.style.position = "fixed";
                        helper.style.opacity = "0";
                        document.body.appendChild(helper);
                        helper.select();
                        document.execCommand("copy");
                        helper.remove();
                    }
                    if (label) label.textContent = "Link copiado";
                } catch {
                    if (label) label.textContent = "No se pudo copiar";
                }

                window.setTimeout(() => {
                    if (label) label.textContent = originalLabel;
                }, 1800);
            });
        })();
    </script>
}
