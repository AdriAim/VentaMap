@page
@model VentaMap.Pages.ContactoModel
@{
    ViewData["Title"] = "Contacto";
}

<section class="form-shell narrow">
    <div class="section-heading">
        <span class="eyebrow">Contacto</span>
        <h1>Envianos tu consulta</h1>
        <p>Envía tu mensaje y te contestaremos a la brevedad</p>
    </div>

    <form method="post" class="stack-form">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
        {
            <div class="status-banner success-banner contact-success-banner">@Model.SuccessMessage</div>
        }

        <div class="register-row">
            <label>
                <span>Nombre</span>
                <input asp-for="Input.Name" />
                <span asp-validation-for="Input.Name" class="text-danger"></span>
            </label>
        </div>

        <div class="register-row">
            <label>
                <span>Email</span>
                <input asp-for="Input.Email" />
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </label>
        </div>

        <div class="register-row">
            <label>
                <span>Asunto</span>
                <input asp-for="Input.Subject" />
                <span asp-validation-for="Input.Subject" class="text-danger"></span>
            </label>
        </div>

        <div class="register-row">
            <label>
                <span>Mensaje</span>
                <textarea asp-for="Input.Message" rows="6"></textarea>
                <span asp-validation-for="Input.Message" class="text-danger"></span>
            </label>
        </div>

        <div class="hero-actions">
            <button type="submit" class="primary-pill">Enviar mensaje</button>
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
