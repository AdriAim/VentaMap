@model dynamic

<div class="preview-overlay" id="reportModal" hidden>
    <div class="preview-backdrop" data-report-close="true"></div>
    <div class="preview-dialog preview-dialog-compact">
        <div class="modal-content ventamap-modal preview-modal-shell report-modal-shell">
            <div class="modal-header">
                <div class="preview-modal-title">
                    <img class="preview-modal-logo" src="~/images/logo5.png" alt="VentaMap" />
                    <h5 class="modal-title" id="reportModalTitle">Seleccioná un motivo</h5>
                </div>
                <button type="button" class="btn-close" data-report-close="true" aria-label="Cerrar"></button>
            </div>
            <form id="reportForm" class="preview-modal-body report-modal-body">
                <input type="hidden" name="publicationId" value="0" />
                @{
                    var isFirstReason = true;
                }
                @foreach (var reason in Model.ReportReasons)
                {
                    <label class="report-choice">
                        <input name="reason" type="radio" value="@reason.Id" @(isFirstReason ? "checked" : null) />
                        <span>@reason.Name</span>
                    </label>
                    isFirstReason = false;
                }
                <label class="report-note wide">
                    <span>Mensaje opcional</span>
                    <textarea name="comment" rows="3" maxlength="500" placeholder="Contá brevemente por qué lo denunciás."></textarea>
                </label>
                <div class="report-actions">
                    <button type="button" class="ghost-pill" data-report-close="true">Cancelar</button>
                    <button type="submit" class="primary-pill">Enviar denuncia</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="preview-overlay" id="publicationPreviewModal" hidden>
    <div class="preview-backdrop" data-preview-close="true"></div>
    <div class="preview-dialog">
        <div class="modal-content ventamap-modal preview-modal-shell">
            <div class="modal-header">
                <div class="preview-modal-title">
                    <img class="preview-modal-logo" src="~/images/logo5.png" alt="VentaMap" />
                    <h5 class="modal-title" id="publicationPreviewTitle">Detalle de anuncio</h5>
                </div>
                <button type="button" class="btn-close" data-preview-close="true" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body preview-modal-body" id="publicationPreviewBody">
            </div>
        </div>
    </div>
</div>

<div class="preview-overlay" id="favoriteModal" hidden>
    <div class="preview-backdrop" data-favorite-close="true"></div>
    <div class="preview-dialog preview-dialog-compact">
        <div class="modal-content ventamap-modal preview-modal-shell report-modal-shell">
            <div class="modal-header">
                <div class="preview-modal-title">
                    <img class="preview-modal-logo" src="~/images/logo5.png" alt="VentaMap" />
                    <h5 class="modal-title" id="favoriteModalTitle">Guardar en favoritos</h5>
                </div>
                <button type="button" class="btn-close" data-favorite-close="true" aria-label="Cerrar"></button>
            </div>
            <form id="favoriteForm" class="preview-modal-body report-modal-body">
                <input type="hidden" name="publicationId" value="0" />
                <input type="hidden" name="suggestedListName" value="" />
                <label class="report-note wide">
                    <span>Elegí una lista</span>
                    <select name="listId" data-favorite-list-select>
                        <option value="">Crear una nueva</option>
                    </select>
                </label>
                <label class="report-note wide" data-favorite-new-list-field hidden>
                    <span>O escribí una nueva</span>
                    <input type="text" name="newListName" maxlength="120" placeholder="Inmuebles" />
                </label>
                <div class="report-actions">
                    <button type="button" class="ghost-pill" data-favorite-close="true">Cancelar</button>
                    <button type="submit" class="primary-pill">Guardar</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="preview-overlay" id="favoriteListModal" hidden>
    <div class="preview-backdrop" data-favorite-list-close="true"></div>
    <div class="preview-dialog">
        <div class="modal-content ventamap-modal preview-modal-shell">
            <div class="modal-header">
                <div class="preview-modal-title">
                    <img class="preview-modal-logo" src="~/images/logo5.png" alt="VentaMap" />
                    <h5 class="modal-title" id="favoriteListModalTitle">Mi lista</h5>
                </div>
                <button type="button" class="btn-close" data-favorite-list-close="true" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body preview-modal-body" id="favoriteListModalBody">
            </div>
        </div>
    </div>
</div>
