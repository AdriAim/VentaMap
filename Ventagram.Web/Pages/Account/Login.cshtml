@page
@model Ventagram.Pages.Account.LoginModel
@{
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    ViewData["Title"] = isAuthenticated ? "Bienvenido" : "Ingresar";
}

@if (isAuthenticated)
{
    <section class="form-shell login-welcome">
        <div class="section-heading">
            <span class="eyebrow">Ventagram</span>
            <h1>Bienvenido, @(User.Identity?.Name ?? "Usuario")</h1>
            <p>¿Qué querés hacer hoy?</p>
        </div>
        <div class="login-welcome-actions">
            <a class="primary-pill login-welcome-explore" asp-page="/Browse">
                <i class="fa-solid fa-compass" aria-hidden="true"></i>
                <span>Explorar</span>
            </a>
            <a class="primary-pill" asp-page="/Publications/Create">
                <i class="fa-solid fa-circle-plus" aria-hidden="true"></i>
                <span>Publicar</span>
            </a>
        </div>
    </section>
}
else
{
<section class="form-shell narrow">
    <div class="section-heading">
        <span class="eyebrow">Acceso</span>
        <h1>Ingresá a tu cuenta</h1>
        <p>Ingresá con email y contraseña.</p>
    </div>

    <form method="post" class="stack-form">
        <input type="hidden" asp-for="ReturnUrl" />
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="register-row">
            <label>
                <span>Email</span>
                <input asp-for="Input.Email" />
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </label>
        </div>
        <div class="register-row">
            <label>
                <span>Contraseña</span>
                <input asp-for="Input.Password" type="password" />
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </label>
        </div>
        <a class="field-hint" asp-page="/Account/ForgotPassword">¿Olvidaste tu contraseña?</a>
        <div class="hero-actions">
            <button type="submit" class="primary-pill">Ingresar</button>
            @if (Model.IsGoogleEnabled)
            {
                <button type="submit" asp-page-handler="Google" class="ghost-pill">Continuar con Google</button>
            }
        </div>
    </form>
</section>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
