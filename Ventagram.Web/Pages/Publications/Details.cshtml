@page "{id:int}"
@model Ventagram.Pages.Publications.DetailsModel
@{
    ViewData["Title"] = "Detalle";
}

@{
    var detailsEndpoint = $"/api/content/details/{Model.Id}";
    if (string.Equals(Request.Query["debug"], "1", StringComparison.Ordinal))
    {
        detailsEndpoint += "?debug=1";
    }
}

<div id="api-page" data-page-kind="details" data-api-endpoint="@detailsEndpoint"></div>

<partial name="_GlobalModals" model="Model" />
