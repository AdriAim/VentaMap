@model ResultsShellViewModel

<section class="map-layout" data-browse-scroll-target data-map-layout>
    <div class="map-view-row">
        <div class="map-view-spacer" aria-hidden="true"></div>
    </div>
    <div class="map-canvas-shell">
        <div class="map-canvas" id="map"
             data-map-style-url="@Model.MapStyleUrl"
             data-map-tiles-url="@Model.MapTilesUrlTemplate"
             data-map-attribution="@Model.MapAttributionHtml"
             data-map-initial-lat="@Model.MapInitialLatitude"
             data-map-initial-lng="@Model.MapInitialLongitude"
             data-map-markers-endpoint="@Model.MapMarkersApiEndpoint"
             data-map-selection-action="@Model.MapSelectionAction"
             data-markers='@Model.MarkersJson'>
            @if (string.IsNullOrWhiteSpace(Model.MapStyleUrl) && string.IsNullOrWhiteSpace(Model.MapTilesUrlTemplate))
            {
                <div class="map-placeholder">
                    <h2>@Model.MapPlaceholderTitle</h2>
                    <p>@Model.MapPlaceholderMessage</p>
                </div>
            }
        </div>
    </div>
    <div class="map-sidebar">
        <div class="map-results" data-map-selection-panel>
            <div class="map-results-copy">
                <span class="gallery-kicker">Pin seleccionado</span>
                <h2>@Model.MapSelectionTitle</h2>
                @if (!string.IsNullOrWhiteSpace(Model.MapSelectionDescription))
                {
                    <p>@Model.MapSelectionDescription</p>
                }
            </div>
            <div class="map-selection-card" data-map-selection-card></div>
        </div>
    </div>
</section>
