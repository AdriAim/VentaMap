@using System.Text.Json
@model PublicationDetailsContentViewModel

@if (Model.Publication is null)
{
    <section class="empty-state">
        <h1>Anuncio no encontrado</h1>
        <p>Es posible que haya vencido o sido dada de baja.</p>
    </section>
}
else
{
    var publication = Model.Publication;
    var debugSuffix = string.Equals(Context?.Request.Query["debug"], "1", StringComparison.Ordinal) ? "?debug=1" : string.Empty;
    var displayTitle = publication.Title.Split(" - oportunidad", StringSplitOptions.TrimEntries)[0];
    var detailHeadline = string.IsNullOrWhiteSpace(publication.ShortDescription) ? displayTitle : publication.ShortDescription;
    var owner = publication.User;
    var hideReportActions = string.Equals(Context?.Request.Query["ownerView"], "1", StringComparison.Ordinal);
    var canStartChat = Model.IsAuthenticated
        && Model.CurrentUserId.HasValue
        && publication.UserId.HasValue
        && publication.UserId.Value != Model.CurrentUserId.Value
        && owner?.AllowsSiteChat == true
        && publication.IsActive;
    var showSiteChatAction = owner?.AllowsSiteChat == true
        && publication.IsActive;
    var canEmail = owner?.RespondsEmails == true || (owner is null && !string.IsNullOrWhiteSpace(publication.ContactEmail));
    var canCall = owner?.AcceptsCalls == true || (owner is null && !string.IsNullOrWhiteSpace(publication.ContactPhone));
    var canWhatsApp = owner?.RespondsWhatsApp == true || (owner is null && !string.IsNullOrWhiteSpace(publication.ContactPhone));
    var siteChatOnlyContact = showSiteChatAction && !canEmail && !canCall && !canWhatsApp;
    var contactEmail = publication.ContactEmail ?? owner?.Email ?? string.Empty;
    var contactPhone = publication.ContactPhone ?? owner?.Phone ?? string.Empty;
    var whatsappNumber = NormalizeWhatsAppNumber(contactPhone);
    var operationLabel = publication.OperationType?.ToDisplayName();
    var operationLetter = operationLabel?[0].ToString().ToUpperInvariant();
    var hasMapLocation = publication.Latitude.HasValue && publication.Longitude.HasValue && !publication.HideFromMap;
    var detailEyebrow = publication.OperationType.HasValue
        ? $"{publication.Group} · {publication.OperationType.Value.ToDisplayName()} · {(publication.Category?.Name ?? "Sin categoría")}"
        : $"{publication.Group} · {(publication.Category?.Name ?? "Sin categoría")}";
    if (hasMapLocation && !string.IsNullOrWhiteSpace(publication.Locality))
    {
        detailEyebrow = $"{detailEyebrow} · {publication.Locality}";
    }
    var pricePeriod = operationLabel switch
    {
        "Alquiler" => " / mes",
        "Temporario" => " / día",
        _ => string.Empty
    };
    var formattedPrice = $"{publication.Currency} {publication.Price.ToString("N0", System.Globalization.CultureInfo.GetCultureInfo("es-AR"))}{pricePeriod}";

    <section class="detail-hero">
        <div>
            <span class="eyebrow">
                @detailEyebrow
            </span>
            <h1><span class="detail-title-text">@detailHeadline</span></h1>
            <p>@displayTitle</p>
            @if (!hideReportActions)
            {
                <p>
                    <button type="button"
                            class="ghost-pill report-trigger detail-report-trigger"
                            data-publication-id="@publication.Id"
                            data-publication-code="@publication.ToAdCode()"
                            data-publication-title="@displayTitle">
                        Denunciar
                    </button>
                </p>
            }
        </div>
        <div class="price-panel" id="publication-start">
            <span class="detail-price-cluster">
                <strong>
                    @if (!string.IsNullOrWhiteSpace(operationLetter))
                    {
                        <span class="detail-operation-letter gallery-tooltip-trigger gallery-tooltip-top" data-tooltip-label="@operationLabel">@operationLetter</span>
                    }
                    @formattedPrice
                </strong>
            </span>
            <span>@publication.Locality</span>
            @if (owner?.IsCompany == true && !string.IsNullOrWhiteSpace(owner.CompanySlug))
            {
                <a class="price-panel-company-link" href="/@owner.CompanySlug">
                    @if (!string.IsNullOrWhiteSpace(owner.CompanyLogoUrl))
                    {
                        <img src="@owner.CompanyLogoUrl" alt="@owner.CompanyName" class="price-panel-company-logo" />
                    }
                    else
                    {
                        <span class="price-panel-company-logo price-panel-company-logo-fallback" aria-hidden="true">
                            <i class="fa-solid fa-building"></i>
                        </span>
                    }
                    <span class="price-panel-company-copy">
                        <strong>@(owner.CompanyName ?? publication.ContactName)</strong>
                        <span>Ver catalogo de la empresa</span>
                    </span>
                </a>
            }
            else
            {
                <span>@publication.ContactName</span>
            }
            @if (Model.AdvertiserReviews is { Count: > 0 } advertiserReviews)
            {
                <div class="verified-rating-popover" data-rating-popover>
                    <button type="button"
                            class="verified-rating-trigger"
                            aria-haspopup="dialog"
                            aria-expanded="false"
                            data-rating-popover-trigger>
                        <span class="verified-rating-star" aria-hidden="true">★</span>
                        <strong>@advertiserReviews.Average.ToString("0.0", System.Globalization.CultureInfo.GetCultureInfo("es-AR"))</strong>
                        <span>· @advertiserReviews.Count reseña@(advertiserReviews.Count == 1 ? "" : "s") verificada@(advertiserReviews.Count == 1 ? "" : "s")</span>
                    </button>
                    <div class="verified-rating-panel" role="dialog" aria-label="Ultimas reseñas verificadas del anunciante">
                        <strong>Ultimas reseñas verificadas</strong>
                        @if (advertiserReviews.RecentComments.Count == 0)
                        {
                            <p>Tiene operaciones verificadas, pero todavia no hay comentarios publicos.</p>
                        }
                        else
                        {
                            <div class="verified-rating-comments">
                                @foreach (var review in advertiserReviews.RecentComments)
                                {
                                    <article class="verified-rating-comment">
                                        <span class="verified-rating-comment-stars" aria-label="@review.Stars estrellas">@(new string('★', review.Stars))</span>
                                        <p>@review.Comment</p>
                                        <small>Operacion verificada · @review.SubmittedAtUtc.ToLocalTime().ToString("dd/MM/yyyy")</small>
                                    </article>
                                }
                            </div>
                        }
                    </div>
                </div>
            }
            else if (Model.AdvertiserReviews is not null)
            {
                <span class="verified-rating-empty">☆ Aun no tiene reseñas</span>
            }
        </div>
    </section>

    <section class="detail-grid detail-gallery-grid">
        <div class="detail-gallery">
            @{
                var detailMediaIndex = 0;
            }
            @if (!string.IsNullOrWhiteSpace(publication.PrimaryVideoUrl))
            {
                <div class="detail-gallery-video-frame detail-media-trigger"
                     data-detail-media-item="true"
                     data-detail-media-index="@detailMediaIndex"
                     data-detail-media-type="video"
                     data-detail-media-src="@publication.PrimaryVideoUrl"
                     data-detail-media-title="@displayTitle">
                    <video class="detail-gallery-primary"
                           preload="metadata"
                           playsinline
                           src="@publication.PrimaryVideoUrl"></video>
                    <button type="button" class="detail-gallery-video-play" data-detail-video-play="true" aria-label="Reproducir video">
                        <i class="fa-solid fa-play" aria-hidden="true"></i>
                    </button>
                </div>
                detailMediaIndex++;
            }
            @foreach (var image in publication.ImageList)
            {
                var shouldLoadImmediately = detailMediaIndex < 2;
                <img src="@image"
                     alt="@displayTitle"
                     class="detail-media-trigger"
                     loading="@(shouldLoadImmediately ? "eager" : "lazy")"
                     decoding="async"
                     data-detail-media-item="true"
                     data-detail-media-index="@detailMediaIndex"
                     data-detail-media-type="image"
                     data-detail-media-src="@image"
                     data-detail-media-title="@displayTitle" />
                detailMediaIndex++;
            }
        </div>
    </section>

    <div class="preview-overlay detail-media-overlay" data-detail-media-overlay hidden>
        <div class="preview-backdrop" data-detail-media-close="true"></div>
        <button type="button" class="btn-close detail-media-close" data-detail-media-close="true" aria-label="Cerrar"></button>
        <button type="button" class="detail-media-nav detail-media-prev" data-detail-media-nav="prev" aria-label="Imagen anterior">
            <i class="fa-solid fa-chevron-left" aria-hidden="true"></i>
        </button>
        <div class="detail-media-body" data-detail-media-body></div>
        <button type="button" class="detail-media-nav detail-media-next" data-detail-media-nav="next" aria-label="Imagen siguiente">
            <i class="fa-solid fa-chevron-right" aria-hidden="true"></i>
        </button>
        <div class="detail-media-caption" data-detail-media-caption hidden></div>
    </div>

    <section class="detail-stack">
        <article class="detail-panel">
            <h2>Descripción</h2>
            <p>@publication.LongDescription</p>
        </article>
        <article class="detail-panel detail-contact-panel">
            <h2>Contacto</h2>
            @if (owner?.IsCompany == true && !string.IsNullOrWhiteSpace(owner.CompanySlug))
            {
                <a class="detail-company-card" href="/@owner.CompanySlug">
                    @if (!string.IsNullOrWhiteSpace(owner.CompanyLogoUrl))
                    {
                        <img src="@owner.CompanyLogoUrl" alt="@owner.CompanyName" class="detail-company-card-logo" />
                    }
                    else
                    {
                        <span class="detail-company-card-logo detail-company-card-logo-fallback" aria-hidden="true">
                            <i class="fa-solid fa-building"></i>
                        </span>
                    }
                    <span class="detail-company-card-copy">
                        <strong>@(owner.CompanyName ?? publication.ContactName)</strong>
                        @if (!string.IsNullOrWhiteSpace(owner.CompanyIndustry))
                        {
                            <span>@owner.CompanyIndustry</span>
                        }
                    </span>
                    <span class="detail-company-card-action">Ver empresa</span>
                </a>
            }
            else
            {
                <p><strong>@publication.ContactName</strong></p>
            }
            @if (canStartChat || (!Model.IsAuthenticated && showSiteChatAction))
            {
                <p class="detail-contact-chat">
                    @if (siteChatOnlyContact)
                    {
                        <span class="detail-contact-label">El usuario sólo habilitó el chat de ventagram como medio de contacto.</span>
                    }
                    @if (canStartChat)
                    {
                    <button type="button"
                            class="primary-pill detail-chat-trigger"
                            data-start-chat="true"
                            data-publication-id="@publication.Id">
                        Chatear en ventagram
                    </button>
                    }
                    else
                    {
                    <a class="primary-pill detail-chat-trigger" href="/Account/Login?returnUrl=@Uri.EscapeDataString($"/Publications/Details/{publication.Id}{debugSuffix}")">
                        Chatear en ventagram
                    </a>
                    }
                </p>
            }
            @if ((canEmail && !string.IsNullOrWhiteSpace(contactEmail))
                || (canCall && !string.IsNullOrWhiteSpace(contactPhone))
                || (canWhatsApp && !string.IsNullOrWhiteSpace(whatsappNumber)))
            {
                <div class="detail-contact-actions">
                    @if (canEmail && !string.IsNullOrWhiteSpace(contactEmail))
                    {
                        <a class="whatsapp-link contact-email-link detail-contact-tooltip" href="mailto:@contactEmail" data-tooltip-label="Mail a: @contactEmail">
                            <span class="contact-email-mark" aria-hidden="true">
                                <svg viewBox="0 0 24 24" role="img" aria-hidden="true">
                                    <path fill="currentColor" d="M20 4H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2Zm0 4.2-8 4.8-8-4.8V6l8 4.8L20 6v2.2Z" />
                                </svg>
                            </span>
                            <span class="detail-contact-label">Mail a: @contactEmail</span>
                        </a>
                    }
                    @if (canCall && !string.IsNullOrWhiteSpace(contactPhone))
                    {
                        <a class="call-link" href="tel:@contactPhone">
                            <span class="call-mark" aria-hidden="true">
                                <svg viewBox="0 0 24 24" role="img" aria-hidden="true">
                                    <path fill="currentColor" d="M6.2 3.1c.6-.6 1.5-.8 2.2-.6l2 .7c.8.3 1.3 1 1.4 1.8l.2 1.8c0 .7-.3 1.4-.9 1.8l-1.4.9c-.4.3-.5.8-.3 1.2.8 1.8 2.3 3.3 4.1 4.1.4.2.9.1 1.2-.3l.9-1.4c.4-.6 1.1-.9 1.8-.9l1.8.2c.8.1 1.5.6 1.8 1.4l.7 2c.2.8 0 1.7-.6 2.2l-1.1 1.1c-.7.7-1.8 1-2.8.7-2.9-.8-5.7-2.5-8-4.8s-4-5.1-4.8-8c-.3-1 .1-2.1.7-2.8L6.2 3.1Z" />
                                    <path fill="currentColor" d="M16.4 2.1c.2-.2.6-.2.8 0 1.9 1.4 3.5 3 4.8 4.9.2.2.1.6-.1.8l-1 .8c-.2.2-.6.2-.8-.1-1.1-1.5-2.5-2.9-4-4-.3-.2-.3-.5-.1-.8l.4-.6Zm-3.1 3.1c.2-.2.6-.2.8 0 1.4 1 2.7 2.2 3.7 3.7.2.2.1.6-.1.8l-1 .8c-.2.2-.6.1-.8-.1-.9-1.2-2-2.2-3.2-3.1-.3-.2-.3-.5-.1-.8l.7-1.3Zm-3.1 3.1c.2-.2.6-.2.8 0 .9.7 1.7 1.5 2.4 2.4.2.2.1.6-.1.8l-1 .8c-.2.2-.6.1-.8-.1-.6-.7-1.2-1.3-1.9-1.9-.3-.2-.3-.5-.1-.8l.7-1.2Z" />
                                </svg>
                            </span>
                            <span class="detail-contact-label">Llamar: @contactPhone</span>
                        </a>
                    }
                    @if (canWhatsApp && !string.IsNullOrWhiteSpace(whatsappNumber))
                    {
                        <a class="whatsapp-link" href="https://wa.me/@whatsappNumber" target="_blank" rel="noopener noreferrer">
                            <span class="whatsapp-mark" aria-hidden="true">
                                <svg viewBox="0 0 24 24" role="img" aria-hidden="true">
                                    <path fill="currentColor" d="M12 2a10 10 0 0 0-8.54 15.22L2 22l4.92-1.28A10 10 0 1 0 12 2Zm0 18.18a8.18 8.18 0 0 1-4.14-1.12l-.29-.17-2.9.75.77-2.81-.19-.3A8.19 8.19 0 1 1 12 20.18Zm4.75-5.96c-.26-.13-1.51-.74-1.75-.82-.24-.08-.42-.13-.6.12-.17.25-.7.82-.86.98-.16.17-.32.2-.58.07-.26-.13-1.1-.41-2.1-1.29-.78-.69-1.31-1.55-1.47-1.81-.16-.26-.02-.4.11-.52.12-.12.26-.31.39-.46.13-.15.17-.26.25-.43.08-.18.04-.33-.02-.45-.06-.12-.6-1.44-.82-1.97-.22-.53-.45-.46-.61-.47h-.52c-.18 0-.45.06-.69.32-.24.26-.94.9-.94 2.2 0 1.3.95 2.56 1.08 2.75.13.18 1.86 2.84 4.52 3.99.64.28 1.13.44 1.53.56.64.21 1.22.18 1.68.1.52-.07 1.54-.62 1.76-1.24.22-.61.22-1.13.16-1.23-.06-.09-.24-.16-.5-.29Z" />
                                </svg>
                            </span>
                            <span class="detail-contact-label">Whatsapp: @contactPhone</span>
                        </a>
                    }
                </div>
            }
        </article>
    </section>

    <section class="detail-grid two">
        <article class="detail-panel">
            <div class="section-heading">
                <span class="eyebrow">Ubicación</span>
                <h2>Dónde queda</h2>
            </div>
            @if (hasMapLocation)
            {
                <div class="detail-map-canvas"
                     data-publication-map
                     data-map-mode="detail"
                     data-map-style-url="@Model.MapStyleUrl"
                     data-map-tiles-url="@Model.MapTilesUrlTemplate"
                     data-map-attribution="@Model.MapAttributionHtml"
                     data-markers='@Html.Raw(JsonSerializer.Serialize(new[]
                     {
                         new
                         {
                             id = publication.Id,
                             videoUrl = publication.PrimaryVideoUrl,
                             title = displayTitle,
                             image = publication.ImageList.FirstOrDefault(),
                             images = publication.ImageList.Take(11).ToList(),
                             detailsUrl = $"/Publications/Details/{publication.Id}{debugSuffix}",
                             lat = publication.Latitude,
                             lng = publication.Longitude,
                             price = $"{publication.Currency} {publication.Price:0}"
                         }
                     }))'></div>
                <div class="detail-map-footer" data-detail-map-footer>
                    @if (!string.IsNullOrWhiteSpace(Model.MapLocationLabel))
                    {
                        <span class="detail-map-location-label">@Model.MapLocationLabel</span>
                    }
                </div>
            }
            else if (publication.HideFromMap)
            {
                <div class="empty-state compact-empty">
                    <h3>Sin ubicación en mapa</h3>
                    <p>El usuario no eligió una ubicación, se encuentra en: <strong>@publication.Locality</strong></p>
                </div>
            }
            else
            {
                <div class="empty-state compact-empty">
                    <h3>Sin ubicación disponible</h3>
                    <p>Este anuncio no comparte una ubicación en el mapa.</p>
                </div>
            }
        </article>
        <article class="detail-panel">
            <h2>Ficha técnica</h2>
            <div class="spec-list">
                @if (publication.FieldValues.Any(x => !string.Equals(x.CategoryField?.InternalName, "operacion", StringComparison.OrdinalIgnoreCase)))
                {
                    @foreach (var fieldValue in publication.FieldValues
                        .Where(x => !string.Equals(x.CategoryField?.InternalName, "operacion", StringComparison.OrdinalIgnoreCase))
                        .OrderBy(x => x.CategoryField.SortOrder)
                        .ThenBy(x => x.CategoryField.Label))
                    {
                        <div class="spec-item spec-card">
                            <span class="spec-item-label">@fieldValue.CategoryField.Label</span>
                            <strong class="spec-item-value">@FormatFieldValue(fieldValue)@RenderUnit(fieldValue.CategoryField.Unit)</strong>
                        </div>
                    }
                }
                else
                {
                    <div class="empty-state compact-empty">
                        <h3>No hay datos técnicos disponibles</h3>
                    </div>
                }
            </div>
        </article>
    </section>
}

@functions {
    private static string NormalizeWhatsAppNumber(string phone)
    {
        var digits = new string((phone ?? string.Empty).Where(char.IsDigit).ToArray());
        if (digits.StartsWith("549"))
        {
            return digits;
        }

        if (digits.StartsWith("54"))
        {
            return $"549{digits[2..]}";
        }

        return digits;
    }

    private static string FormatFieldValue(PublicationFieldValue fieldValue)
    {
        if (fieldValue.ValueBoolean.HasValue)
        {
            return fieldValue.ValueBoolean.Value ? "Si" : "No";
        }

        if (fieldValue.ValueNumber.HasValue)
        {
            return fieldValue.ValueNumber.Value.ToString("0.##");
        }

        return fieldValue.ValueText ?? string.Empty;
    }

    private static string RenderUnit(string? unit)
    {
        return string.IsNullOrWhiteSpace(unit) ? string.Empty : $" {unit}";
    }
}

