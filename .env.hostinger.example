MYSQL_ROOT_PASSWORD=changeme
VENTAMAP_DATABASE_NAME=ventamap
VENTAMAP_CHAT_DATABASE_NAME=ventamap_chat

# Only set these when migrating an existing legacy stack. They preserve the
# existing database and Data Protection keys while the Compose project changes.
MYSQL_DATA_VOLUME=ventamap-local_mysql_data
MYSQL_DATA_VOLUME_EXTERNAL=false
DATAPROTECTION_KEYS_VOLUME=ventamap-local_dataprotection_keys
DATAPROTECTION_KEYS_VOLUME_EXTERNAL=false

VENTAMAP_WEB_PORT=8080
VENTAMAP_CHAT_PORT=8081
VENTAMAP_WEB_BASE_URL=https://ventamap.com.ar
VENTAMAP_WEB_BASE_URL_ALT=https://www.ventamap.com.ar
VENTAMAP_CHAT_BASE_URL=https://ventamap.com.ar
VENTAMAP_COOKIE_DOMAIN=.ventamap.com.ar

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_USER=info@ventamap.com.ar
SMTP_PASSWORD=
SMTP_FROM_EMAIL=info@ventamap.com.ar
SMTP_CONTACT_RECIPIENT=info@ventamap.com.ar
SMTP_FROM_NAME=VentaMap
SMTP_USE_SSL=true
SMTP_TIMEOUT_SECONDS=25

MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
MAP_TILES_URL_TEMPLATE=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_ATTRIBUTION_HTML=&copy; <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noreferrer">OpenStreetMap</a> contributors
MAP_GEOCODING_SEARCH_URL_TEMPLATE=
MAP_REVERSE_GEOCODING_URL_TEMPLATE=

R2_ACCOUNT_ID=
# Alternativa si no quieres usar R2_ACCOUNT_ID:
R2_SERVICE_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# URL publica final del bucket o dominio propio, por ejemplo:
# https://media.tudominio.com o https://pub-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.r2.dev
R2_PUBLIC_BASE_URL=
R2_PREFIX=publications
R2_REGION=auto
R2_MAX_IMAGE_SIDE=1600
R2_WEBP_QUALITY=82
R2_WATERMARK_SCALE=0.14
R2_WATERMARK_OPACITY=0.45
R2_MAX_VIDEO_BYTES=83886080

# Credenciales productivas de Mercado Pago. Nunca subir valores reales al repositorio.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
DATABASE_APPLY_MIGRATIONS_ON_STARTUP=false
DATABASE_RUN_SEED_DATA_ON_STARTUP=false

TZ=America/Argentina/Buenos_Aires
